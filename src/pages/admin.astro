---
// Panel de Aimar y Deborah.
//
// Vive en /admin a propósito: la URL rara de antes era teatro de seguridad
// desde que la contraseña se valida bien en el servidor, y lo único que
// conseguía era que los novios no se acordaran de la dirección.
//
// El acceso es usuario + contraseña; a cambio se recibe un token firmado con
// caducidad, que es lo único que se guarda en el navegador.
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <link rel="icon" href="/logo-positivo.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Panel · Aimar & Deborah</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@200;300;400;500&display=swap" rel="stylesheet" />
  <style is:global>@import '../styles/theme.css';</style>
  <style is:global>
    :root {
      --s1:.25rem; --s2:.5rem; --s3:.75rem; --s4:1rem; --s5:1.5rem; --s6:2rem; --s7:3rem;
      --barra-h: 52px;
    }
    body { background: var(--cream); padding-bottom: 6rem; }

    /* ── ACCESO ──────────────────────────────────────────────────── */
    .acceso {
      min-height: 100dvh; display: flex; flex-direction: column;
      align-items: center; justify-content: center; padding: var(--s6) var(--s5); text-align: center;
    }
    .acceso[hidden] { display: none !important; }
    .acceso-titulo { font-family: 'Sloop', cursive; font-size: 2.6rem; color: var(--dark); margin-bottom: var(--s2); }
    .acceso-texto { font-size: .85rem; color: var(--gray); margin-bottom: var(--s5); }
    .acceso-caja { width: 100%; max-width: 320px; }
    .campo {
      width: 100%; background: #fff; border: 1px solid var(--border); border-radius: 12px;
      color: var(--dark); font-family: inherit; font-size: 1rem; font-weight: 300;
      padding: .9rem 1rem; text-align: center;
    }
    .campo:focus { outline: none; border-color: var(--pink); }
    .boton {
      font-family: inherit; font-size: .72rem; letter-spacing: .18em; text-transform: uppercase;
      color: #fff; background: var(--dark); border: none; border-radius: 100px;
      padding: .9rem 1.6rem; cursor: pointer; transition: opacity .2s, transform .15s;
    }
    .boton:active { transform: scale(.97); }
    .boton:disabled { opacity: .4; cursor: not-allowed; }
    .boton.ancho { width: 100%; margin-top: var(--s3); }
    .boton.suave { background: #fff; color: var(--dark); border: 1px solid var(--border); }
    .boton.peligro { background: var(--err); }
    .error-texto { color: var(--err); font-size: .8rem; margin-top: var(--s3); min-height: 1.2em; }

    /* ── ESTRUCTURA ──────────────────────────────────────────────── */
    .panel[hidden] { display: none !important; }
    .barra {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between; gap: var(--s3);
      padding: 0 var(--s4); height: var(--barra-h);
      background: rgba(250,248,244,.9); backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
    }
    .barra-marca { font-family: 'Sloop', cursive; font-size: 1.6rem; color: var(--dark); }
    .barra-acciones { display: flex; gap: var(--s2); align-items: center; }
    .icono-btn {
      background: none; border: 1px solid var(--border); border-radius: 100px;
      font-family: inherit; font-size: .62rem; letter-spacing: .1em; text-transform: uppercase;
      color: var(--gray); padding: .4rem .8rem; cursor: pointer; white-space: nowrap;
    }
    .icono-btn.activo { background: var(--dark); color: #fff; border-color: var(--dark); }

    .secciones {
      display: flex; gap: var(--s1); overflow-x: auto; scrollbar-width: none;
      padding: var(--s3) var(--s4); position: sticky; top: var(--barra-h); z-index: 90;
      background: rgba(250,248,244,.94); backdrop-filter: blur(14px);
    }
    .secciones::-webkit-scrollbar { display: none; }
    .seccion {
      flex: none; font-family: inherit; font-size: .66rem; letter-spacing: .12em;
      text-transform: uppercase; color: var(--gray); background: none;
      border: 1px solid transparent; border-radius: 100px; padding: .45rem .9rem;
      cursor: pointer; white-space: nowrap;
    }
    .seccion.activa { color: var(--dark); background: #fff; border-color: var(--border); }
    .seccion .cuenta { opacity: .55; margin-left: .3rem; }

    .filtros {
      display: flex; gap: var(--s2); flex-wrap: wrap; padding: 0 var(--s4) var(--s3);
    }
    .filtros select {
      font-family: inherit; font-size: .72rem; color: var(--dark);
      background: #fff; border: 1px solid var(--border); border-radius: 100px;
      padding: .4rem .8rem; cursor: pointer;
    }

    /* ── REJILLA ─────────────────────────────────────────────────── */
    .contenido { padding: 0 var(--s2) var(--s6); max-width: 1500px; margin: 0 auto; }
    .rejilla { display: flex; gap: var(--s2); align-items: flex-start; }
    .columna { flex: 1 1 0; display: flex; flex-direction: column; gap: var(--s2); min-width: 0; }

    .celda {
      position: relative; width: 100%; padding: 0; border: 0; background: var(--blush);
      border-radius: 10px; overflow: hidden; cursor: pointer; font-family: inherit; line-height: 0;
      -webkit-tap-highlight-color: transparent;
    }
    .celda img { width: 100%; height: 100%; display: block; object-fit: cover; }
    .celda.oculta img { opacity: .3; filter: grayscale(1); }
    .celda.marcada { outline: 3px solid var(--pink-deep); outline-offset: -3px; }
    .celda-pie {
      position: absolute; inset: auto 0 0 0; padding: 1.4rem .5rem .4rem;
      background: linear-gradient(transparent, rgba(20,8,12,.7));
      font-size: .6rem; color: #fff; text-align: left; line-height: 1.3;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .marca-sel {
      position: absolute; top: 6px; left: 6px; width: 22px; height: 22px; border-radius: 50%;
      border: 2px solid #fff; background: rgba(0,0,0,.3); display: none;
      align-items: center; justify-content: center; color: #fff; font-size: .7rem;
    }
    .modo-seleccion .marca-sel { display: flex; }
    .celda.marcada .marca-sel { background: var(--pink-deep); border-color: var(--pink-deep); }
    .etiqueta {
      position: absolute; top: 6px; right: 6px;
      background: rgba(15,8,10,.6); color: #fff; font-size: .55rem;
      letter-spacing: .04em; padding: .15rem .4rem; border-radius: 100px; line-height: 1.4;
    }

    .vacio-msg { text-align: center; color: var(--gray); font-size: .85rem; padding: var(--s7) var(--s5); }

    /* ── BARRA DE LOTE ───────────────────────────────────────────── */
    .lote {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 150;
      display: flex; gap: var(--s2); justify-content: center; flex-wrap: wrap;
      padding: var(--s3) var(--s4) calc(var(--s3) + env(safe-area-inset-bottom, 0px));
      background: rgba(250,248,244,.96); backdrop-filter: blur(14px);
      border-top: 1px solid var(--border);
    }
    .lote[hidden] { display: none !important; }
    .lote .boton { padding: .75rem 1.2rem; font-size: .64rem; }

    /* ── ESTADÍSTICAS ────────────────────────────────────────────── */
    .tarjetas { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: var(--s3); padding: 0 var(--s2); }
    .tarjeta-dato {
      background: #fff; border: 1px solid var(--border); border-radius: 14px;
      padding: var(--s4); text-align: center;
    }
    .dato-num { font-size: 2rem; font-weight: 200; color: var(--dark); line-height: 1; }
    .dato-lbl { font-size: .6rem; letter-spacing: .14em; text-transform: uppercase; color: var(--gray); margin-top: var(--s2); }

    .bloque { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: var(--s5); margin: var(--s4) var(--s2) 0; }
    .bloque h3 { font-size: .66rem; letter-spacing: .16em; text-transform: uppercase; color: var(--gray); font-weight: 400; margin-bottom: var(--s4); }
    .fila-rank { display: flex; align-items: center; gap: var(--s3); margin-bottom: var(--s2); font-size: .82rem; }
    .fila-rank .nom { flex: none; width: 40%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fila-rank .bar { flex: 1; height: 8px; background: var(--blush); border-radius: 100px; overflow: hidden; }
    .fila-rank .bar span { display: block; height: 100%; background: var(--pink-deep); border-radius: 100px; }
    .fila-rank .n { flex: none; color: var(--gray); font-size: .75rem; min-width: 2ch; text-align: right; }

    .horas { display: flex; align-items: flex-end; gap: 3px; height: 90px; }
    .hora-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: var(--s1); }
    .hora-bar { width: 100%; background: var(--rose); border-radius: 3px 3px 0 0; min-height: 2px; }
    .hora-lbl { font-size: .52rem; color: var(--gray); }

    .medidor { height: 10px; background: var(--blush); border-radius: 100px; overflow: hidden; margin: var(--s3) 0 var(--s2); }
    .medidor span { display: block; height: 100%; background: var(--pink-deep); border-radius: 100px; }
    .medidor-txt { font-size: .78rem; color: var(--gray); }
    .medidor-txt.aviso { color: var(--err); }

    /* ── SUBIDA DEL REPORTAJE ────────────────────────────────────── */
    .subida { padding: 0 var(--s2); }
    .soltar {
      border: 1px dashed var(--border); border-radius: 14px; background: #fff;
      padding: var(--s7) var(--s5); text-align: center; cursor: pointer; position: relative;
    }
    .soltar:hover { border-color: var(--pink); }
    .soltar input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .soltar-txt { font-size: .85rem; color: var(--gray); }
    .progreso-caja { margin-top: var(--s4); font-size: .8rem; color: var(--dark); text-align: center; }
    .progreso-linea { height: 4px; background: var(--border); border-radius: 100px; overflow: hidden; margin-top: var(--s2); }
    .progreso-linea span { display: block; height: 100%; width: 0; background: var(--pink-deep); transition: width .3s; }

    /* ── VISOR ───────────────────────────────────────────────────── */
    .visor { position: fixed; inset: 0; z-index: 300; display: none; background: rgba(12,6,9,.97); align-items: center; justify-content: center; }
    .visor.abierto { display: flex; }
    .visor img, .visor video { max-width: 100vw; max-height: 100dvh; object-fit: contain; }
    .visor-cerrar {
      position: absolute; top: calc(var(--s4) + env(safe-area-inset-top,0px)); right: var(--s4);
      width: 38px; height: 38px; border-radius: 50%; border: none; cursor: pointer;
      background: rgba(255,255,255,.15); color: #fff; font-size: 1.1rem;
    }
    .visor-pie { position: absolute; bottom: var(--s6); left: 0; right: 0; text-align: center; color: rgba(255,255,255,.8); font-size: .78rem; }

    .aviso-flotante {
      position: fixed; left: 50%; top: calc(var(--barra-h) + var(--s3)); transform: translate(-50%,-20px);
      z-index: 250; background: var(--dark); color: #fff; border-radius: 100px;
      padding: .65rem 1.3rem; font-size: .78rem; opacity: 0; pointer-events: none;
      transition: opacity .3s, transform .3s; max-width: 90vw; text-align: center;
    }
    .aviso-flotante.visible { opacity: 1; transform: translate(-50%,0); }
  </style>
</head>
<body>

  <!-- ACCESO -->
  <div class="acceso" id="acceso">
    <h1 class="acceso-titulo">Panel</h1>
    <p class="acceso-texto">Aimar &amp; Deborah</p>
    <div class="acceso-caja">
      <input class="campo" type="text" id="usuario" placeholder="Usuario"
             autocomplete="username" autocapitalize="none" autocorrect="off" enterkeyhint="next" />
      <input class="campo" type="password" id="clave" placeholder="Contraseña"
             autocomplete="current-password" enterkeyhint="go" style="margin-top:.6rem" />
      <button class="boton ancho" id="entrar">Entrar</button>
      <p class="error-texto" id="accesoError"></p>
    </div>
  </div>

  <!-- PANEL -->
  <div class="panel" id="panel" hidden>
    <nav class="barra">
      <span class="barra-marca">Panel</span>
      <div class="barra-acciones">
        <button class="icono-btn" id="btnSeleccion">Seleccionar</button>
        <button class="icono-btn" id="btnRecargar">Actualizar</button>
        <button class="icono-btn" id="btnSalir">Salir</button>
      </div>
    </nav>

    <div class="secciones" role="tablist">
      <button class="seccion activa" data-vista="invitados">Invitados <span class="cuenta" id="cInv"></span></button>
      <button class="seccion" data-vista="oficial">Reportaje <span class="cuenta" id="cOfi"></span></button>
      <button class="seccion" data-vista="papelera">Papelera <span class="cuenta" id="cPap"></span></button>
      <button class="seccion" data-vista="stats">Resumen</button>
      <button class="seccion" data-vista="subir">Subir reportaje</button>
      <button class="seccion" data-vista="descargar">Descargar</button>
    </div>

    <div class="filtros" id="filtros">
      <select id="fTipo">
        <option value="">Fotos y vídeos</option>
        <option value="foto">Solo fotos</option>
        <option value="video">Solo vídeos</option>
      </select>
      <select id="fQuien"><option value="">Todo el mundo</option></select>
      <select id="fOrden">
        <option value="nuevas">Más recientes</option>
        <option value="viejas">Más antiguas</option>
      </select>
    </div>

    <div class="contenido">
      <div class="rejilla" id="rejilla"></div>
      <p class="vacio-msg" id="vacioMsg" hidden></p>

      <!-- RESUMEN -->
      <section id="vistaStats" hidden>
        <div class="tarjetas" id="tarjetasStats"></div>
        <div class="bloque">
          <h3>Quién ha subido más</h3>
          <div id="ranking"></div>
        </div>
        <div class="bloque">
          <h3>Cómo se repartió la noche</h3>
          <div class="horas" id="horas"></div>
        </div>
        <div class="bloque">
          <h3>Espacio ocupado</h3>
          <div class="medidor"><span id="medidorBar"></span></div>
          <p class="medidor-txt" id="medidorTxt"></p>
          <button class="boton suave ancho" id="btnLimpiar">Limpiar subidas incompletas</button>
        </div>
      </section>

      <!-- SUBIR REPORTAJE -->
      <section class="subida" id="vistaSubir" hidden>
        <div class="bloque">
          <h3>Categoría</h3>
          <select id="catSubida" class="campo" style="text-align:left">
            <option value="ceremonia">Ceremonia</option>
            <option value="cocktail">Cóctel</option>
            <option value="comida">Comida</option>
            <option value="baile">Baile</option>
            <option value="momentos">Momentos</option>
          </select>
        </div>
        <div class="soltar" id="soltar">
          <input type="file" id="ficheros" accept="image/*,video/*" multiple />
          <p class="soltar-txt">Arrastra aquí las fotos del fotógrafo<br/>o toca para elegirlas</p>
        </div>
        <div class="progreso-caja" id="progresoSubida" hidden>
          <span id="progresoTxt"></span>
          <div class="progreso-linea"><span id="progresoBar"></span></div>
        </div>
      </section>

      <!-- DESCARGAR -->
      <section id="vistaDescargar" hidden>
        <div class="bloque">
          <h3>Descargar el álbum</h3>
          <p class="medidor-txt" id="descResumen"></p>
          <p class="medidor-txt" style="margin-top:.6rem;opacity:.75">
            Se prepara en tandas para no saturar el móvil. De las fotos de invitados existe
            la versión de 2560&nbsp;px, de sobra para imprimir en 20×30&nbsp;cm.
          </p>
          <button class="boton ancho" id="btnDescargar">Descargar todo</button>
          <div class="progreso-linea" style="margin-top:1rem"><span id="descBar"></span></div>
          <p class="medidor-txt" id="descEstado" style="margin-top:.5rem"></p>
        </div>
      </section>
    </div>

    <div class="lote" id="lote" hidden>
      <button class="boton suave" id="btnCancelarSel">Cancelar</button>
      <button class="boton" id="btnOcultar">Ocultar</button>
      <button class="boton suave" id="btnRestaurar" hidden>Restaurar</button>
      <button class="boton peligro" id="btnEliminar" hidden>Borrar definitivamente</button>
    </div>
  </div>

  <div class="visor" id="visor">
    <button class="visor-cerrar" id="visorCerrar" aria-label="Cerrar">✕</button>
    <div id="visorSlot"></div>
    <p class="visor-pie" id="visorPie"></p>
  </div>

  <div class="aviso-flotante" id="aviso"></div>

<script>
  import { AdminApi, NoAutorizado } from '../lib/adminApi';
  import type { MediaAdmin } from '../lib/adminApi';
  import { procesar, ErrorMedio } from '../lib/media';
  import { ColaSubida } from '../lib/uploadQueue';
  import { downloadZip } from 'client-zip';

  const API = import.meta.env.PUBLIC_API_BASE ?? '';
  const $ = (id: string) => document.getElementById(id)!;
  const POR_TANDA = 150;   // ~75 MB por ZIP: manejable en un móvil

  let api: AdminApi;
  let todo: MediaAdmin[] = [];
  let vista = 'invitados';
  let seleccion = new Set<string>();
  let modoSel = false;

  // ── ACCESO ────────────────────────────────────────────────────────
  // En el navegador solo se guarda el token, nunca la contraseña.
  const LLAVE = 'ad-sesion';

  function abrirPanel() {
    $('acceso').hidden = true;
    $('panel').hidden = false;
  }

  function salir(motivo?: string) {
    sessionStorage.removeItem(LLAVE);
    $('panel').hidden = true;
    $('acceso').hidden = false;
    ($('clave') as HTMLInputElement).value = '';
    $('accesoError').textContent = motivo ?? '';
  }

  async function entrar(usuario: string, clave: string) {
    const err = $('accesoError');
    err.textContent = '';
    if (!usuario || !clave) { err.textContent = 'Escribe usuario y contraseña.'; return; }

    ($('entrar') as HTMLButtonElement).disabled = true;
    try {
      const sesion = await api.entrar(usuario, clave);
      sessionStorage.setItem(LLAVE, JSON.stringify(sesion));
      abrirPanel();
      await recargar();
    } catch (e) {
      err.textContent = e instanceof NoAutorizado
        ? 'Usuario o contraseña incorrectos.'
        : String((e as Error).message);
    } finally {
      ($('entrar') as HTMLButtonElement).disabled = false;
    }
  }

  api = new AdminApi(API);
  $('entrar').addEventListener('click', () => entrar(
    ($('usuario') as HTMLInputElement).value.trim(),
    ($('clave') as HTMLInputElement).value,
  ));
  for (const id of ['usuario', 'clave']) {
    $(id).addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') $('entrar').click();
    });
  }
  $('btnSalir').addEventListener('click', () => salir());

  // Retomar una sesión abierta, si no ha caducado.
  try {
    const guardada = JSON.parse(sessionStorage.getItem(LLAVE) ?? 'null');
    if (guardada?.token && guardada.expira > Date.now()) {
      api.usarToken(guardada.token);
      ($('usuario') as HTMLInputElement).value = guardada.usuario ?? '';
      abrirPanel();
      recargar();
    }
  } catch { /* sesión ilegible: se pide entrar otra vez */ }

  // ── AVISOS ────────────────────────────────────────────────────────
  let avisoTimer: number;
  function avisar(txt: string) {
    const el = $('aviso');
    el.textContent = txt;
    el.classList.add('visible');
    clearTimeout(avisoTimer);
    avisoTimer = window.setTimeout(() => el.classList.remove('visible'), 3600);
  }

  // ── DATOS ─────────────────────────────────────────────────────────
  async function recargar() {
    try {
      const { items } = await api.media({ estado: 'todas' });
      todo = items;
      rellenarQuien();
      pintar();
      actualizarCuentas();
    } catch (e) {
      if (e instanceof NoAutorizado) { salir('La sesión ha caducado. Entra otra vez.'); return; }
      avisar((e as Error).message);
    }
  }
  $('btnRecargar').addEventListener('click', () => recargar());

  function actualizarCuentas() {
    $('cInv').textContent = String(todo.filter((i) => i.origen === 'invitado' && !i.oculta).length);
    $('cOfi').textContent = String(todo.filter((i) => i.origen === 'oficial' && !i.oculta).length);
    $('cPap').textContent = String(todo.filter((i) => i.oculta).length);
  }

  function rellenarQuien() {
    const sel = $('fQuien') as HTMLSelectElement;
    const previo = sel.value;
    const nombres = [...new Set(todo.map((i) => i.nombre).filter(Boolean))].sort();
    sel.replaceChildren();
    const cero = document.createElement('option');
    cero.value = ''; cero.textContent = 'Todo el mundo';
    sel.appendChild(cero);
    for (const n of nombres) {
      const o = document.createElement('option');
      o.value = n; o.textContent = n;   // textContent: lo escribe un invitado
      sel.appendChild(o);
    }
    sel.value = previo;
  }

  function visibles(): MediaAdmin[] {
    let lista = todo;
    if (vista === 'papelera') lista = lista.filter((i) => i.oculta);
    else if (vista === 'invitados') lista = lista.filter((i) => i.origen === 'invitado' && !i.oculta);
    else if (vista === 'oficial') lista = lista.filter((i) => i.origen === 'oficial' && !i.oculta);

    const tipo = ($('fTipo') as HTMLSelectElement).value;
    const quien = ($('fQuien') as HTMLSelectElement).value;
    if (tipo) lista = lista.filter((i) => i.tipo === tipo);
    if (quien) lista = lista.filter((i) => i.nombre === quien);

    const orden = ($('fOrden') as HTMLSelectElement).value;
    return [...lista].sort((a, b) => (orden === 'viejas' ? a.ts - b.ts : b.ts - a.ts));
  }

  // ── REJILLA ───────────────────────────────────────────────────────
  function columnas(): number {
    const w = window.innerWidth;
    if (w >= 1200) return 6;
    if (w >= 900) return 5;
    if (w >= 560) return 4;
    return 3;
  }

  function pintar() {
    const esRejilla = ['invitados', 'oficial', 'papelera'].includes(vista);
    $('filtros').hidden = !esRejilla;
    $('rejilla').hidden = !esRejilla;
    $('vistaStats').hidden = vista !== 'stats';
    $('vistaSubir').hidden = vista !== 'subir';
    $('vistaDescargar').hidden = vista !== 'descargar';
    if (!esRejilla) { $('vacioMsg').hidden = true; sincronizarLote(); return; }

    const items = visibles();
    const rejilla = $('rejilla');
    rejilla.replaceChildren();
    rejilla.classList.toggle('modo-seleccion', modoSel);

    const n = columnas();
    const cols = Array.from({ length: n }, () => {
      const c = document.createElement('div');
      c.className = 'columna';
      rejilla.appendChild(c);
      return c;
    });

    items.forEach((item, i) => {
      const b = document.createElement('button');
      b.className = 'celda';
      b.type = 'button';
      b.dataset.id = item.id;
      if (item.ancho && item.alto) b.style.aspectRatio = `${item.ancho} / ${item.alto}`;
      if (item.oculta) b.classList.add('oculta');
      if (seleccion.has(item.id)) b.classList.add('marcada');

      const img = document.createElement('img');
      img.src = item.poster ?? item.thumb;
      img.loading = 'lazy';
      img.decoding = 'async';
      img.alt = item.nombre ? `Foto de ${item.nombre}` : 'Foto';
      b.appendChild(img);

      const marca = document.createElement('span');
      marca.className = 'marca-sel';
      marca.textContent = seleccion.has(item.id) ? '✓' : '';
      b.appendChild(marca);

      if (item.tipo === 'video' || item.categoria) {
        const et = document.createElement('span');
        et.className = 'etiqueta';
        et.textContent = item.tipo === 'video' ? '▶' : item.categoria!;
        b.appendChild(et);
      }

      if (item.nombre) {
        const pie = document.createElement('span');
        pie.className = 'celda-pie';
        pie.textContent = item.nombre;   // texto plano: lo escribe un invitado
        b.appendChild(pie);
      }

      b.addEventListener('click', () => {
        if (modoSel) alternar(item.id, b);
        else abrirVisor(item);
      });
      cols[i % n]!.appendChild(b);
    });

    const vacio = $('vacioMsg');
    vacio.hidden = items.length > 0;
    vacio.textContent = vista === 'papelera'
      ? 'La papelera está vacía.'
      : vista === 'oficial'
        ? 'Todavía no hay fotos del reportaje. Súbelas desde «Subir reportaje».'
        : 'No hay nada con estos filtros.';

    sincronizarLote();
  }

  addEventListener('resize', () => { if (!$('rejilla').hidden) pintar(); });
  for (const id of ['fTipo', 'fQuien', 'fOrden']) $(id).addEventListener('change', pintar);

  // ── SECCIONES ─────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.seccion').forEach((btn) => {
    btn.addEventListener('click', async () => {
      document.querySelectorAll('.seccion').forEach((b) => b.classList.remove('activa'));
      btn.classList.add('activa');
      vista = btn.dataset.vista!;
      salirSeleccion();
      pintar();
      if (vista === 'stats') await pintarStats();
      if (vista === 'descargar') pintarDescarga();
      scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  // ── SELECCIÓN ─────────────────────────────────────────────────────
  function alternar(id: string, celda: HTMLElement) {
    if (seleccion.has(id)) seleccion.delete(id); else seleccion.add(id);
    celda.classList.toggle('marcada', seleccion.has(id));
    celda.querySelector('.marca-sel')!.textContent = seleccion.has(id) ? '✓' : '';
    sincronizarLote();
  }
  function salirSeleccion() {
    modoSel = false;
    seleccion.clear();
    $('btnSeleccion').classList.remove('activo');
    $('rejilla').classList.remove('modo-seleccion');
    sincronizarLote();
  }
  function sincronizarLote() {
    const n = seleccion.size;
    const lote = $('lote');
    lote.hidden = !modoSel || n === 0;
    $('btnOcultar').textContent = `Ocultar (${n})`;
    $('btnRestaurar').textContent = `Restaurar (${n})`;
    $('btnEliminar').textContent = `Borrar definitivamente (${n})`;
    // Restaurar y borrar definitivo SOLO existen en la papelera.
    ($('btnOcultar') as HTMLElement).hidden = vista === 'papelera';
    ($('btnRestaurar') as HTMLElement).hidden = vista !== 'papelera';
    ($('btnEliminar') as HTMLElement).hidden = vista !== 'papelera';
  }
  $('btnSeleccion').addEventListener('click', () => {
    modoSel = !modoSel;
    if (!modoSel) seleccion.clear();
    $('btnSeleccion').classList.toggle('activo', modoSel);
    pintar();
  });
  $('btnCancelarSel').addEventListener('click', () => { salirSeleccion(); pintar(); });

  async function accion(fn: () => Promise<unknown>, mensaje: string) {
    const ids = [...seleccion];
    if (!ids.length) return;
    try {
      await fn();
      avisar(mensaje);
      salirSeleccion();
      await recargar();
    } catch (e) {
      avisar((e as Error).message);
    }
  }

  $('btnOcultar').addEventListener('click', () =>
    accion(() => api.ocultar([...seleccion], true), 'Movidas a la papelera'));
  $('btnRestaurar').addEventListener('click', () =>
    accion(() => api.ocultar([...seleccion], false), 'Restauradas'));

  $('btnEliminar').addEventListener('click', () => {
    const n = seleccion.size;
    // La única acción sin vuelta atrás del proyecto: se dice el número y que
    // no se puede deshacer, y solo se llega aquí desde la papelera.
    const ok = confirm(
      `Vas a borrar ${n} ${n === 1 ? 'archivo' : 'archivos'} PARA SIEMPRE.\n\n` +
      'Se eliminan también de Cloudflare y no se pueden recuperar.\n\n¿Seguro?'
    );
    if (!ok) return;
    accion(() => api.eliminar([...seleccion]), `${n} borrados definitivamente`);
  });

  // ── VISOR ─────────────────────────────────────────────────────────
  function abrirVisor(item: MediaAdmin) {
    const slot = $('visorSlot');
    slot.replaceChildren();
    if (item.tipo === 'video') {
      const v = document.createElement('video');
      v.src = item.web; v.controls = true; v.autoplay = true; v.playsInline = true;
      v.poster = item.poster ?? '';
      slot.appendChild(v);
    } else {
      const img = document.createElement('img');
      img.src = item.web;
      img.alt = item.nombre ? `Foto de ${item.nombre}` : 'Foto';
      slot.appendChild(img);
    }
    const cuando = new Date(item.ts).toLocaleString('es-ES');
    $('visorPie').textContent = `${item.nombre || 'Sin nombre'} · ${cuando}${item.oculta ? ' · oculta' : ''}`;
    $('visor').classList.add('abierto');
    document.body.style.overflow = 'hidden';
  }
  function cerrarVisor() {
    $('visor').classList.remove('abierto');
    $('visorSlot').replaceChildren();
    document.body.style.overflow = '';
  }
  $('visorCerrar').addEventListener('click', cerrarVisor);
  $('visor').addEventListener('click', (e) => { if (e.target === $('visor')) cerrarVisor(); });
  document.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Escape') cerrarVisor();
  });

  // ── ESTADÍSTICAS ──────────────────────────────────────────────────
  function tarjeta(num: string, lbl: string) {
    const d = document.createElement('div');
    d.className = 'tarjeta-dato';
    const n = document.createElement('div'); n.className = 'dato-num'; n.textContent = num;
    const l = document.createElement('div'); l.className = 'dato-lbl'; l.textContent = lbl;
    d.append(n, l);
    return d;
  }

  async function pintarStats() {
    try {
      const s = await api.stats();
      $('tarjetasStats').replaceChildren(
        tarjeta(String(s.visibles), 'en la galería'),
        tarjeta(String(s.fotos), 'fotos'),
        tarjeta(String(s.videos), 'vídeos'),
        tarjeta(String(s.personas), 'personas'),
        tarjeta(String(s.oficiales), 'del reportaje'),
        tarjeta(String(s.ocultas), 'en la papelera'),
      );

      const rank = $('ranking');
      rank.replaceChildren();
      const tope = Math.max(1, ...s.ranking.map((r) => r.n));
      for (const r of s.ranking) {
        const fila = document.createElement('div');
        fila.className = 'fila-rank';
        const nom = document.createElement('span'); nom.className = 'nom'; nom.textContent = r.nombre;
        const bar = document.createElement('span'); bar.className = 'bar';
        const dentro = document.createElement('span'); dentro.style.width = `${(r.n / tope) * 100}%`;
        bar.appendChild(dentro);
        const n = document.createElement('span'); n.className = 'n'; n.textContent = String(r.n);
        fila.append(nom, bar, n);
        rank.appendChild(fila);
      }
      if (!s.ranking.length) rank.textContent = 'Todavía no hay fotos.';

      const horas = $('horas');
      horas.replaceChildren();
      const topeH = Math.max(1, ...s.porHora.map((h) => h.n));
      for (const h of s.porHora) {
        const col = document.createElement('div'); col.className = 'hora-col';
        const bar = document.createElement('div'); bar.className = 'hora-bar';
        bar.style.height = `${(h.n / topeH) * 70}px`;
        const lbl = document.createElement('span'); lbl.className = 'hora-lbl'; lbl.textContent = h.hora;
        col.append(bar, lbl);
        horas.appendChild(col);
      }
      if (!s.porHora.length) horas.textContent = '';

      const { bytes, limiteBytes, objetos } = s.almacenamiento;
      const pct = Math.min(100, (bytes / limiteBytes) * 100);
      $('medidorBar').style.width = `${pct}%`;
      const gb = (bytes / 1024 ** 3).toFixed(2);
      const txt = $('medidorTxt');
      txt.textContent = `${gb} GB de 10 GB gratuitos · ${objetos} archivos (${pct.toFixed(1)} %)`;
      txt.classList.toggle('aviso', pct > 80);
    } catch (e) {
      avisar((e as Error).message);
    }
  }

  $('btnLimpiar').addEventListener('click', async () => {
    try {
      const r = await api.limpiarParciales();
      avisar(r.limpiadas ? `${r.limpiadas} subidas incompletas limpiadas` : 'No había nada que limpiar');
      await pintarStats();
    } catch (e) { avisar((e as Error).message); }
  });

  // ── SUBIR REPORTAJE ───────────────────────────────────────────────
  const cola = new ColaSubida(API);
  const ficheros = $('ficheros') as HTMLInputElement;
  const soltar = $('soltar');

  soltar.addEventListener('dragover', (e) => { e.preventDefault(); soltar.style.borderColor = 'var(--pink)'; });
  soltar.addEventListener('dragleave', () => { soltar.style.borderColor = ''; });
  soltar.addEventListener('drop', (e) => {
    e.preventDefault(); soltar.style.borderColor = '';
    const dt = (e as DragEvent).dataTransfer;
    if (dt?.files?.length) { ficheros.files = dt.files; ficheros.dispatchEvent(new Event('change')); }
  });

  ficheros.addEventListener('change', async () => {
    const lista = Array.from(ficheros.files ?? []);
    ficheros.value = '';
    if (!lista.length) return;

    const categoria = ($('catSubida') as HTMLSelectElement).value;
    const token = JSON.parse(sessionStorage.getItem(LLAVE) ?? '{}')?.token ?? '';
    $('progresoSubida').hidden = false;
    $('progresoTxt').textContent = `Preparando ${lista.length}…`;

    const fallos: string[] = [];
    for (const f of lista) {
      try {
        const medio = await procesar(f);
        await cola.encolar(medio, 'Reportaje', 'novios', { origen: 'oficial', categoria, token });
      } catch (err) {
        fallos.push(err instanceof ErrorMedio ? err.message : `No se pudo leer «${f.name}».`);
      }
    }
    if (fallos.length) avisar(fallos[0]!);
  });

  cola.alCambiar((r) => {
    if (!r.total) { $('progresoSubida').hidden = true; return; }
    $('progresoSubida').hidden = false;
    $('progresoBar').style.width = `${Math.round((r.hechos / r.total) * 100)}%`;
    if (r.hechos === r.total && !r.fallidos) {
      $('progresoTxt').textContent = `Listo: ${r.hechos} al reportaje`;
      setTimeout(() => { cola.limpiarHechos(); recargar(); }, 2500);
    } else {
      const partes = [`${r.hechos} de ${r.total}`];
      if (r.reintentando) partes.push('reintentando');
      if (r.fallidos) partes.push(`${r.fallidos} sin subir`);
      $('progresoTxt').textContent = partes.join(' · ');
    }
  });

  // ── DESCARGAR ─────────────────────────────────────────────────────
  function paraDescargar(): MediaAdmin[] {
    return todo.filter((i) => !i.oculta).sort((a, b) => a.ts - b.ts);
  }

  function pintarDescarga() {
    const items = paraDescargar();
    const tandas = Math.ceil(items.length / POR_TANDA);
    $('descResumen').textContent = items.length
      ? `${items.length} archivos · ${tandas} ${tandas === 1 ? 'descarga' : 'descargas'} de hasta ${POR_TANDA}`
      : 'Todavía no hay nada que descargar.';
    ($('btnDescargar') as HTMLButtonElement).disabled = items.length === 0;
  }

  $('btnDescargar').addEventListener('click', async () => {
    const items = paraDescargar();
    const boton = $('btnDescargar') as HTMLButtonElement;
    boton.disabled = true;

    try {
      for (let t = 0; t * POR_TANDA < items.length; t++) {
        const tanda = items.slice(t * POR_TANDA, (t + 1) * POR_TANDA);
        $('descEstado').textContent = `Preparando tanda ${t + 1}…`;

        const ficheros: { name: string; input: Response }[] = [];
        for (let k = 0; k < tanda.length; k++) {
          const it = tanda[k]!;
          const num = String(t * POR_TANDA + k + 1).padStart(4, '0');
          const ext = it.web.split('.').pop() ?? 'webp';
          const quien = (it.nombre || 'sin-nombre').replace(/[^\p{L}\p{N}]+/gu, '-');
          ficheros.push({ name: `AimarDeborah-${num}-${quien}.${ext}`, input: await fetch(it.web) });
          $('descBar').style.width = `${Math.round(((k + 1) / tanda.length) * 100)}%`;
        }

        const blob = await downloadZip(ficheros).blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `AimarDeborah-fotos-${t + 1}.zip`;
        a.click();
        URL.revokeObjectURL(url);
        $('descEstado').textContent = `Tanda ${t + 1} descargada`;
      }
      avisar('Descarga completa');
    } catch (e) {
      $('descEstado').textContent = 'No se pudo completar la descarga.';
      avisar((e as Error).message);
    } finally {
      boton.disabled = false;
      $('descBar').style.width = '0%';
    }
  });
</script>
</body>
</html>
