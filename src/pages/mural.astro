---
// Pantalla para proyectar en la sala. Sin controles, sin scroll.
// Ver tu foto aparecer aquí es lo que hace que la gente suba fotos.
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Mural · Aimar & Deborah</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@200;300&display=swap" rel="stylesheet" />
  <style is:global>@import '../styles/theme.css';</style>
  <style is:global>
    body { background: #0d0708; overflow: hidden; height: 100vh; }
    .mural { position: fixed; inset: 0; }
    .diapo {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 1.1s ease;
    }
    .diapo.activa { opacity: 1; }
    .diapo img, .diapo video { max-width: 100%; max-height: 100%; object-fit: contain; }
    .fondo {
      position: absolute; inset: 0; z-index: -1;
      background-size: cover; background-position: center;
      filter: blur(60px) brightness(0.35); transform: scale(1.15);
    }
    .autor {
      position: fixed; bottom: 3.5rem; left: 0; right: 0; text-align: center;
      color: rgba(255,255,255,0.9); font-size: 1.5rem; font-weight: 200;
      letter-spacing: 0.3em; text-transform: uppercase;
      text-shadow: 0 2px 20px rgba(0,0,0,0.8); opacity: 0; transition: opacity 0.8s;
    }
    .autor.visible { opacity: 1; }
    .marca {
      position: fixed; top: 2.5rem; left: 0; right: 0; text-align: center;
      color: rgba(255,255,255,0.45); font-size: 0.75rem;
      letter-spacing: 0.45em; text-transform: uppercase;
    }
    .aviso {
      position: fixed; inset: 0; display: flex; flex-direction: column;
      align-items: center; justify-content: center; text-align: center;
      color: rgba(255,255,255,0.7); gap: 1.5rem; padding: 2rem;
    }
    .aviso h1 { font-family: 'Sloop', cursive; font-size: 5rem; font-weight: normal; color: var(--pink); }
    .aviso p { font-size: 1.2rem; font-weight: 200; letter-spacing: 0.2em; max-width: 30ch; line-height: 1.8; }
    .nueva {
      position: fixed; top: 2rem; right: 2rem; padding: 0.6rem 1.4rem;
      background: rgba(242,179,206,0.15); border: 1px solid var(--pink);
      color: var(--pink); border-radius: 50px; font-size: 0.8rem;
      letter-spacing: 0.2em; text-transform: uppercase;
      opacity: 0; transition: opacity 0.5s;
    }
    .nueva.visible { opacity: 1; }
  </style>
</head>
<body>
  <div class="fondo" id="fondo"></div>
  <div class="mural" id="mural"></div>
  <p class="marca">Aimar & Deborah · 12 · 09 · 2026</p>
  <p class="autor" id="autor"></p>
  <div class="nueva" id="nueva">Foto nueva</div>

  <div class="aviso" id="aviso">
    <h1>El mural</h1>
    <p>Aquí aparecerán vuestras fotos.<br/>Sube la tuya desde deborahyaimar.com/fotos</p>
  </div>

<script>
  const API = import.meta.env.PUBLIC_API_BASE ?? '';
  const DURACION = 6000;

  const mural = document.getElementById('mural')!;
  const fondo = document.getElementById('fondo')!;
  const autor = document.getElementById('autor')!;
  const aviso = document.getElementById('aviso')!;
  const nueva = document.getElementById('nueva')!;

  interface Item { id: string; tipo: string; nombre: string; web: string; poster: string | null; }

  let items: Item[] = [];
  let vistos = new Set<string>();
  let indice = 0;
  let cola: Item[] = [];   // fotos recién llegadas: se cuelan las primeras

  // Evita que se apague la pantalla proyectada.
  async function mantenerDespierta() {
    try { await (navigator as any).wakeLock?.request('screen'); } catch {}
  }
  mantenerDespierta();
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') mantenerDespierta();
  });

  // Misma URL siempre (se sirve de la caché del borde) pero sin caché privada
  // del navegador: si no, el mural se congela con las fotos de hace un rato.
  async function traer() {
    try {
      const res = await fetch(`${API}/indice.json`, { cache: 'no-store' });
      if (!res.ok) return;
      const datos = await res.json();
      if (!Array.isArray(datos.items)) return;

      const recientes: Item[] = datos.items;
      if (vistos.size) {
        const nuevas = recientes.filter((i) => !vistos.has(i.id));
        if (nuevas.length) {
          cola.push(...nuevas);
          nueva.classList.add('visible');
          setTimeout(() => nueva.classList.remove('visible'), 4000);
        }
      }
      recientes.forEach((i) => vistos.add(i.id));
      items = recientes;
      if (items.length) aviso.style.display = 'none';
    } catch {}
  }

  function mostrar(item: Item) {
    const anterior = mural.querySelector('.diapo.activa');
    const diapo = document.createElement('div');
    diapo.className = 'diapo';

    const url = item.tipo === 'video' ? (item.poster ?? item.web) : item.web;
    const img = document.createElement('img');
    img.src = url;
    diapo.appendChild(img);
    mural.appendChild(diapo);

    fondo.style.backgroundImage = `url("${CSS.escape(url).replace(/\\/g, '')}")`;

    requestAnimationFrame(() => {
      diapo.classList.add('activa');
      anterior?.classList.remove('activa');
      setTimeout(() => anterior?.remove(), 1300);
    });

    autor.textContent = item.nombre ?? '';
    autor.classList.toggle('visible', Boolean(item.nombre));
  }

  function siguiente() {
    // Las recién llegadas tienen prioridad: el invitado ve su foto enseguida.
    const item = cola.shift() ?? items[indice++ % Math.max(items.length, 1)];
    if (item) mostrar(item);
  }

  traer().then(() => { siguiente(); });
  setInterval(siguiente, DURACION);
  setInterval(traer, 15_000);
</script>
</body>
</html>
