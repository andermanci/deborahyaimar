---
const mediaBase = import.meta.env.PUBLIC_MEDIA_BASE ?? '';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <link rel="icon" href="/logo-positivo.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Galería — Aimar & Deborah · 12 · 09 · 2026" />
  <meta name="robots" content="noindex" />
  <title>Fotos · Aimar & Deborah</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {mediaBase && <link rel="preconnect" href={mediaBase} />}
  <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,200;0,300;0,400;0,500;1,200;1,300&display=swap" rel="stylesheet" />
  <style is:global>@import '../styles/theme.css';</style>
  <style is:global>
    /* NAV */
    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 1.5rem; height: 56px;
      background: rgba(250,248,244,0.92); backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo { height: 26px; }
    .nav-back {
      font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase;
      color: var(--gray); text-decoration: none; transition: color 0.2s;
    }
    .nav-back:hover { color: var(--dark); }
    .nav-upload-btn {
      font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--dark); background: none;
      border: 1px solid var(--border); border-radius: 2px;
      padding: 0.45rem 1rem; cursor: pointer;
      font-family: inherit; transition: border-color 0.2s, color 0.2s;
      text-decoration: none; display: flex; align-items: center; gap: 0.4rem;
    }
    .nav-upload-btn:hover { border-color: var(--pink); color: var(--pink); }
    .nav-upload-btn svg { width: 13px; height: 13px; }

    /* HEADER */
    .gl-header { text-align: center; padding: 4rem 1.5rem 2.5rem; }
    .gl-eyebrow {
      font-size: 0.62rem; letter-spacing: 0.28em; text-transform: uppercase;
      color: var(--pink); margin-bottom: 1rem;
    }
    .gl-title {
      font-family: 'Sloop', cursive; font-size: clamp(2.8rem, 7vw, 4.5rem);
      font-weight: normal; color: var(--dark); line-height: 1.1; margin-bottom: 0.8rem;
    }
    .gl-sub { font-size: 0.82rem; color: var(--gray); letter-spacing: 0.1em; }

    /* TABS */
    .gl-tabs {
      display: flex; justify-content: flex-start; overflow-x: auto;
      border-bottom: 1px solid var(--border); padding: 0 1rem;
      position: sticky; top: 56px; z-index: 90;
      background: rgba(250,248,244,0.95); backdrop-filter: blur(10px);
      scrollbar-width: none;
    }
    .gl-tabs::-webkit-scrollbar { display: none; }
    @media (min-width: 720px) { .gl-tabs { justify-content: center; } }
    .gl-tab {
      font-size: 0.63rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--gray); padding: 0.9rem 1.1rem; white-space: nowrap;
      cursor: pointer; border: none; background: none;
      border-bottom: 2px solid transparent; margin-bottom: -1px;
      transition: color 0.2s, border-color 0.2s; font-family: inherit;
    }
    .gl-tab:hover { color: var(--dark); }
    .gl-tab.active { color: var(--dark); border-bottom-color: var(--pink); }
    .gl-tab[hidden] { display: none; }

    /* GRID */
    .gl-grid-wrap { padding: 2.5rem 1rem 5rem; max-width: 1200px; margin: 0 auto; }
    .gl-grid { column-count: 2; column-gap: 4px; }
    @media (min-width: 480px)  { .gl-grid { column-count: 3; } }
    @media (min-width: 720px)  { .gl-grid { column-count: 4; } }
    @media (min-width: 1000px) { .gl-grid { column-count: 5; } }

    .gl-item {
      -webkit-column-break-inside: avoid; break-inside: avoid;
      margin-bottom: 4px; position: relative; cursor: pointer;
      overflow: hidden; background: var(--rose);
      animation: fadeIn 0.35s ease both;
    }
    .gl-item img { width: 100%; display: block; transition: transform 0.4s; }
    .gl-item:hover img { transform: scale(1.04); }
    .gl-item-name {
      position: absolute; bottom: 0; left: 0; right: 0; padding: 0.35rem 0.6rem;
      background: linear-gradient(transparent, rgba(10,3,3,0.55));
      font-size: 0.58rem; letter-spacing: 0.1em; color: rgba(255,255,255,0.85);
      opacity: 0; transition: opacity 0.25s;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .gl-item:hover .gl-item-name { opacity: 1; }
    @media (hover: none) { .gl-item-name { opacity: 1; } }

    .gl-play {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      pointer-events: none;
    }
    .gl-play span {
      width: 38px; height: 38px; border-radius: 50%;
      background: rgba(0,0,0,0.45); backdrop-filter: blur(2px);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 0.7rem; padding-left: 3px;
    }
    .gl-dur {
      position: absolute; top: 6px; right: 6px;
      background: rgba(0,0,0,0.55); color: #fff;
      font-size: 0.55rem; letter-spacing: 0.06em;
      padding: 1px 5px; border-radius: 2px;
    }

    /* Estado vacío */
    .gl-empty {
      display: none; flex-direction: column; align-items: center; justify-content: center;
      padding: 5rem 2rem; text-align: center;
    }
    .gl-empty.visible { display: flex; }
    .gl-empty-icon { width: 52px; height: 52px; margin-bottom: 2rem; color: var(--rose); }
    .gl-empty-title {
      font-size: 1rem; font-weight: 300; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--dark); margin-bottom: 0.8rem;
    }
    .gl-empty-sub { font-size: 0.82rem; color: var(--gray); max-width: 340px; line-height: 1.8; }

    .gl-estado {
      text-align: center; margin-top: 1.5rem;
      font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--gray); opacity: 0.6;
    }
    .gl-estado span { color: var(--pink); }

    /* LIGHTBOX */
    .lightbox {
      display: none; position: fixed; inset: 0; z-index: 1000;
      background: rgba(12,4,4,0.96); align-items: center; justify-content: center;
      touch-action: pan-y;
    }
    .lightbox.open { display: flex; }
    .lightbox img, .lightbox video { max-width: 92vw; max-height: 88vh; object-fit: contain; }
    .lb-close, .lb-prev, .lb-next {
      position: absolute; background: none; border: none; color: #fff; cursor: pointer;
      transition: opacity 0.2s; opacity: 0.5;
    }
    .lb-close { top: 1rem; right: 1.2rem; font-size: 1.5rem; padding: 0.5rem; }
    .lb-prev, .lb-next { top: 50%; transform: translateY(-50%); font-size: 2.4rem; padding: 1rem 0.8rem; }
    .lb-prev { left: 0; } .lb-next { right: 0; }
    .lb-close:hover, .lb-prev:hover, .lb-next:hover { opacity: 1; }
    .lb-caption {
      position: absolute; bottom: 1.2rem; left: 0; right: 0; text-align: center;
      color: rgba(255,255,255,0.65); font-size: 0.68rem; letter-spacing: 0.12em;
    }

    /* UPLOAD */
    .upload-section { background: var(--blush); border-top: 1px solid var(--border); padding: 4rem 1.5rem; }
    .upload-inner { max-width: 480px; margin: 0 auto; }
    .upload-header { text-align: center; margin-bottom: 2rem; }
    .upload-eyebrow {
      font-size: 0.62rem; letter-spacing: 0.28em; text-transform: uppercase;
      color: var(--pink); margin-bottom: 0.8rem;
    }
    .upload-title {
      font-size: clamp(1.3rem, 3vw, 1.7rem); font-weight: 200;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--dark);
    }
    .uf-label {
      font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--gray); display: block; margin-bottom: 0.4rem;
    }
    .uf-input {
      width: 100%; background: #fff; border: 1px solid var(--border); border-radius: 2px;
      color: var(--dark); font-family: inherit; font-size: 1rem; font-weight: 300;
      padding: 0.75rem 1rem; transition: border-color 0.2s; margin-bottom: 1rem;
    }
    .uf-input:focus { outline: none; border-color: var(--pink); }
    .uf-dropzone {
      border: 1px dashed var(--border); border-radius: 2px;
      padding: 2rem 1.5rem; text-align: center; cursor: pointer;
      transition: border-color 0.2s, background 0.2s; position: relative;
      background: #fff; margin-bottom: 1rem;
    }
    .uf-dropzone:hover, .uf-dropzone.drag-over { border-color: var(--pink); background: rgba(242,179,206,0.06); }
    .uf-dropzone input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
    .uf-dz-icon { color: var(--pink); margin-bottom: 0.7rem; }
    .uf-dz-text { font-size: 0.82rem; color: var(--gray); line-height: 1.6; }
    .uf-dz-hint { font-size: 0.68rem; color: var(--gray); opacity: 0.7; margin-top: 0.3rem; }
    .uf-submit {
      width: 100%; background: var(--dark); border: none; border-radius: 2px;
      color: #fff; font-family: inherit; font-size: 0.72rem; letter-spacing: 0.22em;
      text-transform: uppercase; font-weight: 400; padding: 0.9rem 2rem;
      cursor: pointer; transition: opacity 0.2s;
    }
    .uf-submit:hover { opacity: 0.85; }
    .uf-submit:disabled { opacity: 0.4; cursor: not-allowed; }

    /* Estado de la cola: honesto y permanente */
    .uf-cola { margin-top: 1.2rem; font-size: 0.75rem; color: var(--gray); text-align: center; }
    .uf-cola.tiene-fallos { color: var(--err); }
    .uf-barra { height: 3px; background: var(--border); border-radius: 2px; overflow: hidden; margin-bottom: 0.8rem; }
    .uf-barra span { display: block; height: 100%; background: var(--pink); width: 0; transition: width 0.3s; }
    .uf-reintentar {
      margin-top: 0.6rem; background: none; border: none; cursor: pointer;
      font-family: inherit; font-size: 0.65rem; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--err); border-bottom: 1px solid currentColor;
    }
    .uf-errores { margin-top: 0.6rem; font-size: 0.68rem; color: var(--err); line-height: 1.5; }

    footer {
      background: var(--dark); text-align: center; padding: 2rem 1.5rem;
      color: rgba(255,255,255,0.25); font-size: 0.72rem; letter-spacing: 0.1em;
    }
    .footer-sub { margin-top: 0.2rem; font-size: 0.62rem; opacity: 0.5; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

    /* PRE-BODA */
    .pre-wrap {
      min-height: calc(100vh - 56px); display: flex; flex-direction: column;
      align-items: center; justify-content: center; text-align: center; padding: 4rem 1.5rem;
    }
    .pre-eyebrow {
      font-size: 0.62rem; letter-spacing: 0.28em; text-transform: uppercase;
      color: var(--pink); margin-bottom: 1.2rem;
    }
    .pre-title {
      font-family: 'Sloop', cursive; font-size: clamp(2.8rem, 8vw, 5rem);
      font-weight: normal; color: var(--dark); line-height: 1.1; margin-bottom: 1.4rem;
    }
    .pre-deco { width: 40px; height: 1px; background: var(--rose); margin: 0 auto 2rem; }
    .pre-text { font-size: 0.88rem; color: var(--gray); line-height: 1.9; max-width: 380px; margin-bottom: 3rem; }
    .pre-countdown {
      display: flex; align-items: center; flex-wrap: wrap; justify-content: center;
      gap: 0.6rem 1rem; margin-bottom: 2.5rem; max-width: 360px;
    }
    .pre-cd-block { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; min-width: 56px; }
    .pre-cd-num { font-size: clamp(1.8rem, 8vw, 3rem); font-weight: 200; letter-spacing: 0.05em; color: var(--dark); line-height: 1; }
    .pre-cd-label { font-size: 0.52rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gray); }
    .pre-cd-sep { font-size: 1.2rem; color: var(--rose); margin-bottom: 1rem; }
    @media (max-width: 380px) { .pre-cd-sep { display: none; } }
    .pre-badge {
      font-size: 0.62rem; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--pink); border: 1px solid var(--rose); padding: 0.45rem 1.4rem; border-radius: 50px;
    }
  </style>
</head>
<body>

  <nav>
    <!-- href real, no history.back(): los invitados llegan por QR, sin historial. -->
    <a href="/" class="nav-back">← inicio</a>
    <img src="/logo-positivo.png" alt="A&D" class="nav-logo" />
    <a href="#subir" class="nav-upload-btn" id="navSubir">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
      </svg>
      Subir
    </a>
  </nav>

  <!-- PRE-BODA -->
  <div id="preBoda" hidden>
    <div class="pre-wrap">
      <p class="pre-eyebrow">Galería</p>
      <h2 class="pre-title">Las fotos del día</h2>
      <div class="pre-deco"></div>
      <p class="pre-text">La galería se abre el día de la boda.<br/>Vuelve el 12 de septiembre.</p>
      <div class="pre-countdown">
        <div class="pre-cd-block"><span class="pre-cd-num" id="cdDias">—</span><span class="pre-cd-label">días</span></div>
        <div class="pre-cd-sep">·</div>
        <div class="pre-cd-block"><span class="pre-cd-num" id="cdHoras">—</span><span class="pre-cd-label">horas</span></div>
        <div class="pre-cd-sep">·</div>
        <div class="pre-cd-block"><span class="pre-cd-num" id="cdMins">—</span><span class="pre-cd-label">min</span></div>
        <div class="pre-cd-sep">·</div>
        <div class="pre-cd-block"><span class="pre-cd-num" id="cdSegs">—</span><span class="pre-cd-label">seg</span></div>
      </div>
      <span class="pre-badge">12 · 09 · 2026</span>
    </div>
  </div>

  <!-- POST-BODA -->
  <div id="postBoda" hidden>
    <div class="gl-header">
      <p class="gl-eyebrow">12 · 09 · 2026</p>
      <h1 class="gl-title">Fotos</h1>
      <p class="gl-sub">Aimar & Deborah · Palacio de Murguia</p>
    </div>

    <div class="gl-tabs" id="glTabs" role="tablist">
      <button class="gl-tab active" data-cat="invitados" role="tab" aria-selected="true">Invitados</button>
      <button class="gl-tab" data-cat="todas"      role="tab" aria-selected="false" hidden>Reportaje</button>
      <button class="gl-tab" data-cat="ceremonia"  role="tab" aria-selected="false" hidden>Ceremonia</button>
      <button class="gl-tab" data-cat="cocktail"   role="tab" aria-selected="false" hidden>Cocktail</button>
      <button class="gl-tab" data-cat="comida"     role="tab" aria-selected="false" hidden>Comida</button>
      <button class="gl-tab" data-cat="baile"      role="tab" aria-selected="false" hidden>Baile</button>
      <button class="gl-tab" data-cat="momentos"   role="tab" aria-selected="false" hidden>Momentos</button>
    </div>

    <div class="gl-grid-wrap">
      <div class="gl-grid" id="glGrid"></div>
      <div class="gl-empty" id="glEmpty">
        <svg class="gl-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>
        </svg>
        <p class="gl-empty-title" id="glEmptyTitle">Aún no hay fotos</p>
        <p class="gl-empty-sub" id="glEmptySub">¡Sé el primero! Usa el botón «Subir» de arriba.</p>
      </div>
      <p class="gl-estado" id="glEstado"></p>
    </div>

    <section class="upload-section" id="subir">
      <div class="upload-inner">
        <div class="upload-header">
          <p class="upload-eyebrow">Comparte tus fotos</p>
          <h2 class="upload-title">Sube tus fotos</h2>
        </div>

        <form id="uploadForm">
          <label class="uf-label" for="ufNombre">Tu nombre</label>
          <input class="uf-input" type="text" id="ufNombre" placeholder="Escribe tu nombre" autocomplete="name" required />

          <label class="uf-label">Fotos y vídeos</label>
          <div class="uf-dropzone" id="ufDropzone">
            <input type="file" id="ufFileInput" accept="image/*,video/*" multiple />
            <div class="uf-dz-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
            </div>
            <p class="uf-dz-text">Toca para elegir del carrete</p>
            <p class="uf-dz-hint">Vídeos de hasta 15 segundos</p>
            <p class="uf-dz-hint" id="ufFileCount"></p>
          </div>

          <button type="submit" class="uf-submit" id="ufSubmitBtn">Subir</button>
        </form>

        <div class="uf-cola" id="ufCola" hidden>
          <div class="uf-barra"><span id="ufBarra"></span></div>
          <p id="ufColaTexto"></p>
          <p class="uf-errores" id="ufErrores"></p>
          <button class="uf-reintentar" id="ufReintentar" hidden>Reintentar lo que falló</button>
        </div>
      </div>
    </section>
  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
    <button class="lb-close" id="lbClose" aria-label="Cerrar">✕</button>
    <button class="lb-prev" id="lbPrev" aria-label="Anterior">‹</button>
    <div id="lbSlot"></div>
    <button class="lb-next" id="lbNext" aria-label="Siguiente">›</button>
    <p class="lb-caption" id="lbCaption"></p>
  </div>

  <footer>
    <p>Aimar & Deborah · 12 · 09 · 2026</p>
    <p class="footer-sub">deborahyaimar.com</p>
  </footer>

<script>
  import { procesar, ErrorMedio } from '../lib/media';
  import { ColaSubida } from '../lib/uploadQueue';

  const API = import.meta.env.PUBLIC_API_BASE ?? '';

  // Galería ABIERTA desde ya: los invitados pueden subir antes de la boda
  // (despedida, preparativos, la comida del día anterior...).
  //
  // Para volver a cerrarla hasta el día de la boda, basta con poner:
  //   const APERTURA = new Date('2026-09-12T00:00:00+02:00');
  // La hora lleva +02:00 (Madrid en septiembre) a propósito, para que se abra
  // a la vez para todos sin depender de la zona horaria del móvil.
  const APERTURA: Date | null = null;
  const BODA = new Date('2026-09-12T00:00:00+02:00');
  const abierta = APERTURA === null || new Date() >= APERTURA;

  const $ = (id: string) => document.getElementById(id)!;

  $('preBoda').hidden = abierta;
  $('postBoda').hidden = !abierta;
  ($('navSubir') as HTMLElement).hidden = !abierta;

  // ── CUENTA ATRÁS ────────────────────────────────────────────────────
  if (!abierta && APERTURA) {
    const tick = () => {
      const diff = APERTURA.getTime() - Date.now();
      if (diff <= 0) { location.reload(); return; }
      const p = (n: number) => String(n).padStart(2, '0');
      $('cdDias').textContent  = String(Math.floor(diff / 86400000));
      $('cdHoras').textContent = p(Math.floor((diff % 86400000) / 3600000));
      $('cdMins').textContent  = p(Math.floor((diff % 3600000) / 60000));
      $('cdSegs').textContent  = p(Math.floor((diff % 60000) / 1000));
    };
    tick();
    setInterval(tick, 1000);
  } else {
    arrancarGaleria();
  }

  // ── GALERÍA ─────────────────────────────────────────────────────────
  interface Item {
    id: string; tipo: 'foto' | 'video'; categoria: string | null;
    nombre: string; deviceId: string;
    thumb: string; web: string; poster: string | null;
    duracion: number | null; ancho: number; alto: number; ts: number;
  }

  function arrancarGaleria() {
    const grid    = $('glGrid');
    const vacio   = $('glEmpty');
    const estado  = $('glEstado');
    const tabs    = Array.from(document.querySelectorAll<HTMLButtonElement>('.gl-tab'));

    let cat: string = 'invitados';
    let invitados: Item[] = [];
    let oficiales: Item[] = [];
    const pintados = new Set<string>();

    const visibles = (): Item[] => {
      if (cat === 'invitados') return invitados;
      if (cat === 'todas') return oficiales;
      return oficiales.filter((i) => i.categoria === cat);
    };

    function tarjeta(item: Item, indice: number): HTMLElement {
      const div = document.createElement('div');
      div.className = 'gl-item';
      div.dataset.id = item.id;
      div.style.animationDelay = `${Math.min(indice, 8) * 35}ms`;
      // Reserva el hueco antes de que cargue la imagen: sin esto el masonry
      // baila mientras entran fotos nuevas.
      if (item.ancho && item.alto) div.style.aspectRatio = `${item.ancho} / ${item.alto}`;

      const img = document.createElement('img');
      img.src = item.tipo === 'video' ? (item.poster ?? item.thumb) : item.thumb;
      img.loading = 'lazy';
      img.decoding = 'async';
      img.alt = item.nombre ? `Foto de ${item.nombre}` : 'Foto de la boda';
      div.appendChild(img);

      if (item.tipo === 'video') {
        const play = document.createElement('div');
        play.className = 'gl-play';
        play.innerHTML = '<span>▶</span>';
        div.appendChild(play);
        if (item.duracion) {
          const dur = document.createElement('span');
          dur.className = 'gl-dur';
          dur.textContent = `${Math.round(item.duracion)}s`;
          div.appendChild(dur);
        }
      }

      if (item.nombre) {
        const etiqueta = document.createElement('span');
        etiqueta.className = 'gl-item-name';
        // textContent, nunca innerHTML: el nombre lo escribe un invitado.
        etiqueta.textContent = item.nombre;
        div.appendChild(etiqueta);
      }

      div.addEventListener('click', () => abrirLightbox(item.id));
      return div;
    }

    /** Render incremental: solo añade lo nuevo, nunca repinta la rejilla entera. */
    function render(reinicia = false) {
      if (reinicia) { grid.replaceChildren(); pintados.clear(); }
      const items = visibles();

      items.forEach((item, i) => {
        if (pintados.has(item.id)) return;
        pintados.add(item.id);
        const nodo = tarjeta(item, i);
        // Los más nuevos van arriba.
        const primero = grid.firstElementChild;
        if (primero && Number(primero.getAttribute('data-ts') ?? 0) < item.ts) {
          grid.insertBefore(nodo, primero);
        } else {
          grid.appendChild(nodo);
        }
        nodo.setAttribute('data-ts', String(item.ts));
      });

      vacio.classList.toggle('visible', items.length === 0);
      if (cat === 'invitados') {
        $('glEmptyTitle').textContent = 'Aún no hay fotos';
        $('glEmptySub').textContent = '¡Sé el primero! Usa el botón «Subir» de arriba.';
        estado.textContent = items.length ? `${items.length} fotos · se actualiza sola` : '';
      } else {
        $('glEmptyTitle').textContent = 'El reportaje llegará pronto';
        $('glEmptySub').textContent = 'Cuando el fotógrafo nos entregue las fotos, aparecerán aquí.';
        estado.textContent = items.length ? `${items.length} fotos` : '';
      }
    }

    // ── LIGHTBOX ──────────────────────────────────────────────────────
    const lb = $('lightbox');
    const slot = $('lbSlot');
    let lbId: string | null = null;

    function abrirLightbox(id: string) {
      lbId = id;
      pintarLightbox();
      lb.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function cerrarLightbox() {
      lb.classList.remove('open');
      slot.replaceChildren();
      document.body.style.overflow = '';
      lbId = null;
    }
    function pintarLightbox() {
      const items = visibles();
      const item = items.find((i) => i.id === lbId);
      if (!item) { cerrarLightbox(); return; }

      slot.replaceChildren();
      if (item.tipo === 'video') {
        const v = document.createElement('video');
        v.src = item.web; v.controls = true; v.autoplay = true;
        v.playsInline = true; v.poster = item.poster ?? '';
        slot.appendChild(v);
      } else {
        const img = document.createElement('img');
        img.src = item.web;
        img.alt = item.nombre ? `Foto de ${item.nombre}` : 'Foto de la boda';
        slot.appendChild(img);
      }
      $('lbCaption').textContent = item.nombre ?? '';
    }
    /** Avanza por id, no por índice: las fotos que entran en vivo no te mueven. */
    function paso(dir: number) {
      const items = visibles();
      const i = items.findIndex((x) => x.id === lbId);
      if (i < 0) return;
      lbId = items[(i + dir + items.length) % items.length]!.id;
      pintarLightbox();
    }

    $('lbClose').addEventListener('click', cerrarLightbox);
    $('lbPrev').addEventListener('click', () => paso(-1));
    $('lbNext').addEventListener('click', () => paso(1));
    lb.addEventListener('click', (e) => { if (e.target === lb) cerrarLightbox(); });
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') cerrarLightbox();
      if (e.key === 'ArrowLeft') paso(-1);
      if (e.key === 'ArrowRight') paso(1);
    });

    // Swipe: en el móvil nadie acierta a las flechitas.
    let x0 = 0, y0 = 0;
    lb.addEventListener('touchstart', (e) => {
      x0 = e.touches[0]!.clientX; y0 = e.touches[0]!.clientY;
    }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0]!.clientX - x0;
      const dy = e.changedTouches[0]!.clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) paso(dx < 0 ? 1 : -1);
    }, { passive: true });

    // ── TABS ──────────────────────────────────────────────────────────
    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabs.forEach((b) => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        cat = btn.dataset.cat!;
        render(true);
      });
    });

    // ── SONDEO ────────────────────────────────────────────────────────
    // OJO: siempre la MISMA URL, sin cache-buster. La respuesta está cacheada
    // en el borde 15 s; añadir ?t=Date.now() saltaría la caché y recrearía
    // exactamente el fallo que tumbaba la galería con 150 invitados.
    async function traer(origen: 'invitado' | 'oficial'): Promise<Item[] | null> {
      try {
        const url = origen === 'oficial' ? `${API}/indice.json?origen=oficial` : `${API}/indice.json`;
        const res = await fetch(url);
        if (!res.ok) return null;
        const datos = await res.json();
        return Array.isArray(datos.items) ? datos.items : null;
      } catch { return null; }
    }

    async function refrescar() {
      const [inv, ofi] = await Promise.all([traer('invitado'), traer('oficial')]);
      // Si falla la red, conserva lo que ya había: nunca vaciar la galería
      // por un error puntual (el bug original hacía justo eso).
      if (inv) invitados = inv;
      if (ofi) oficiales = ofi;

      const hayOficiales = oficiales.length > 0;
      tabs.forEach((b) => {
        if (b.dataset.cat !== 'invitados') b.hidden = !hayOficiales;
      });
      render();
    }

    refrescar();
    setInterval(refrescar, 15_000);

    // ── SUBIDA ────────────────────────────────────────────────────────
    const cola = new ColaSubida(API);
    const form = $('uploadForm') as HTMLFormElement;
    const input = $('ufFileInput') as HTMLInputElement;
    const nombreInput = $('ufNombre') as HTMLInputElement;
    const boton = $('ufSubmitBtn') as HTMLButtonElement;
    const cuenta = $('ufFileCount');
    const panel = $('ufCola');
    const barra = $('ufBarra');
    const texto = $('ufColaTexto');
    const errores = $('ufErrores');
    const reintentar = $('ufReintentar') as HTMLButtonElement;

    // El nombre se pide una vez y se recuerda.
    const deviceId = localStorage.getItem('ad-device') ?? crypto.randomUUID();
    localStorage.setItem('ad-device', deviceId);
    nombreInput.value = localStorage.getItem('ad-nombre') ?? '';

    input.addEventListener('change', () => {
      const n = input.files?.length ?? 0;
      cuenta.textContent = n ? `${n} archivo${n > 1 ? 's' : ''} seleccionado${n > 1 ? 's' : ''}` : '';
    });

    const dz = $('ufDropzone');
    dz.addEventListener('dragover', (e) => { e.preventDefault(); dz.classList.add('drag-over'); });
    dz.addEventListener('dragleave', () => dz.classList.remove('drag-over'));
    dz.addEventListener('drop', (e) => {
      e.preventDefault(); dz.classList.remove('drag-over');
      const dt = (e as DragEvent).dataTransfer;
      if (dt?.files?.length) { input.files = dt.files; input.dispatchEvent(new Event('change')); }
    });

    cola.alCambiar((r) => {
      if (!r.total) { panel.hidden = true; return; }
      panel.hidden = false;
      const pct = r.total ? Math.round((r.hechos / r.total) * 100) : 0;
      barra.style.width = `${pct}%`;

      const enCola = r.pendientes - r.reintentando;
      const partes: string[] = [];
      if (r.hechos)       partes.push(`${r.hechos} de ${r.total} subidas`);
      if (r.subiendo)     partes.push(`${r.subiendo} en curso`);
      if (r.reintentando) partes.push(`${r.reintentando} reintentando`);
      if (enCola > 0)     partes.push(`${enCola} en cola`);
      if (r.fallidos)     partes.push(`${r.fallidos} fallidas`);
      texto.textContent = partes.join(' · ');

      panel.classList.toggle('tiene-fallos', r.fallidos > 0);
      reintentar.hidden = r.fallidos === 0;
      errores.textContent = r.items
        .filter((i) => i.estado === 'fallido' && i.error)
        .map((i) => i.error)
        .slice(0, 3)
        .join(' · ');

      // Solo se da por bueno cuando el servidor lo confirmó todo.
      if (r.hechos === r.total && !r.fallidos) {
        texto.textContent = `¡Gracias! ${r.hechos} archivo${r.hechos > 1 ? 's' : ''} en la galería.`;
        refrescar();
      }
    });

    reintentar.addEventListener('click', () => cola.reintentarFallidos());

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const archivos = Array.from(input.files ?? []);
      if (!archivos.length) return;
      if (!API) { errores.textContent = 'La subida aún no está configurada.'; panel.hidden = false; return; }

      const nombre = nombreInput.value.trim();
      localStorage.setItem('ad-nombre', nombre);

      boton.disabled = true;
      boton.textContent = 'Preparando…';
      panel.hidden = false;

      const fallos: string[] = [];
      for (const archivo of archivos) {
        try {
          const medio = await procesar(archivo);
          await cola.encolar(medio, nombre, deviceId);
        } catch (err) {
          fallos.push(err instanceof ErrorMedio ? err.message : `No se pudo procesar «${archivo.name}».`);
        }
      }

      if (fallos.length) errores.textContent = fallos.join(' ');
      form.reset();
      nombreInput.value = nombre;
      cuenta.textContent = '';
      boton.disabled = false;
      boton.textContent = 'Subir';
    });
  }
</script>

</body>
</html>
