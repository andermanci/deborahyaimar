---
const mediaBase = import.meta.env.PUBLIC_MEDIA_BASE ?? '';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <link rel="icon" href="/logo-positivo.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content="Galería — Aimar & Deborah · 12 · 09 · 2026" />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#FAF8F4" />
  <title>Fotos · Aimar & Deborah</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {mediaBase && <link rel="preconnect" href={mediaBase} />}
  <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,200;0,300;0,400;0,500;1,200;1,300&display=swap" rel="stylesheet" />
  <style is:global>@import '../styles/theme.css';</style>
  <style is:global>
    /* Escala de espaciado, para que todo respire igual */
    :root {
      --s1: 0.25rem; --s2: 0.5rem;  --s3: 0.75rem; --s4: 1rem;
      --s5: 1.5rem;  --s6: 2rem;    --s7: 3rem;    --s8: 4rem;
      --nav-h: 52px;
      --fab-h: calc(52px + env(safe-area-inset-bottom, 0px));
    }
    body { overscroll-behavior-y: none; }

    /* ── BARRA SUPERIOR ────────────────────────────────────────────
       Compacta: el título vive aquí, no en un bloque que come pantalla. */
    .barra {
      position: sticky; top: 0; z-index: 100;
      display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
      padding: 0 var(--s4); height: var(--nav-h);
      background: rgba(250,248,244,0.88);
      backdrop-filter: saturate(180%) blur(14px);
      -webkit-backdrop-filter: saturate(180%) blur(14px);
      border-bottom: 1px solid var(--border);
    }
    .barra-atras {
      justify-self: start; display: flex; align-items: center; gap: 0.3rem;
      font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--gray); text-decoration: none;
      padding: var(--s2) var(--s2) var(--s2) 0; margin-left: -2px;
    }
    .barra-atras svg { width: 15px; height: 15px; }
    .barra-titulo {
      font-family: 'Sloop', cursive; font-size: 1.9rem; line-height: 1;
      color: var(--dark); padding-bottom: 2px;
    }
    .barra-vivo {
      justify-self: end; display: flex; align-items: center; gap: 0.4rem;
      font-size: 0.58rem; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--gray); opacity: 0; transition: opacity 0.4s;
    }
    .barra-vivo.visible { opacity: 1; }
    .punto {
      width: 6px; height: 6px; border-radius: 50%; background: var(--pink);
      animation: latido 2.4s ease-in-out infinite;
    }
    @keyframes latido {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.8); }
    }

    /* ── PESTAÑAS (solo si hay más de una) ─────────────────────────── */
    .pestanas {
      display: none; gap: var(--s1); overflow-x: auto; scrollbar-width: none;
      padding: var(--s3) var(--s4); position: sticky; top: var(--nav-h); z-index: 90;
      background: rgba(250,248,244,0.92);
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    }
    .pestanas.visible { display: flex; }
    .pestanas::-webkit-scrollbar { display: none; }
    .pestana {
      flex: none; font-family: inherit; cursor: pointer;
      font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--gray); background: none; border: 1px solid transparent;
      border-radius: 100px; padding: 0.45rem 0.9rem; white-space: nowrap;
      transition: color 0.2s, background 0.2s, border-color 0.2s;
    }
    .pestana.activa { color: var(--dark); background: #fff; border-color: var(--border); }
    .pestana[hidden] { display: none; }

    /* ── REJILLA ───────────────────────────────────────────────────
       Columnas reales en DOM (no columnas CSS): así la foto más nueva
       queda siempre arriba a la izquierda y el orden se lee bien. */
    .rejilla-envoltorio { padding: var(--s2) var(--s2) calc(var(--fab-h) + var(--s8)); }
    @media (min-width: 720px) {
      .rejilla-envoltorio { padding: var(--s4) var(--s4) calc(var(--fab-h) + var(--s8)); max-width: 1500px; margin: 0 auto; }
    }
    .rejilla { display: flex; gap: var(--s2); align-items: flex-start; }
    .columna { flex: 1 1 0; display: flex; flex-direction: column; gap: var(--s2); min-width: 0; }

    .tarjeta {
      position: relative; display: block; width: 100%; padding: 0; border: 0;
      background: var(--blush); border-radius: 10px; overflow: hidden;
      cursor: pointer; font-family: inherit; line-height: 0;
      animation: entrar 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      -webkit-tap-highlight-color: transparent;
    }
    .tarjeta img {
      width: 100%; height: 100%; display: block;
      object-fit: cover;          /* sin esto quedan huecos de fondo */
      transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    @media (hover: hover) {
      .tarjeta:hover img { transform: scale(1.05); }
      .tarjeta:hover .tarjeta-quien { opacity: 1; transform: none; }
    }
    .tarjeta:active { transform: scale(0.985); transition: transform 0.15s; }
    .tarjeta:focus-visible { outline: 2px solid var(--pink); outline-offset: 2px; }

    .tarjeta-quien {
      position: absolute; left: 0; right: 0; bottom: 0;
      padding: 1.6rem 0.6rem 0.5rem;
      background: linear-gradient(transparent, rgba(20,8,12,0.6));
      font-size: 0.62rem; line-height: 1.3; letter-spacing: 0.06em;
      color: #fff; text-align: left;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      text-shadow: 0 1px 3px rgba(0,0,0,0.4);
    }
    @media (hover: hover) {
      .tarjeta-quien { opacity: 0; transform: translateY(4px); transition: opacity 0.25s, transform 0.25s; }
    }
    .tarjeta-mia { box-shadow: inset 0 0 0 2px var(--pink); }

    .insignia {
      position: absolute; top: 7px; right: 7px;
      display: flex; align-items: center; gap: 0.25rem;
      background: rgba(15,8,10,0.55); backdrop-filter: blur(6px);
      color: #fff; font-size: 0.58rem; letter-spacing: 0.04em;
      padding: 0.2rem 0.45rem; border-radius: 100px; line-height: 1;
    }
    .insignia svg { width: 9px; height: 9px; }

    /* ── ESTADO VACÍO: es el propio botón, no un cartel ───────────── */
    .vacio {
      display: none; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; padding: var(--s6) var(--s5) var(--s8);
      min-height: calc(100dvh - var(--nav-h) - var(--fab-h));
    }
    .vacio.visible { display: flex; }
    .vacio-icono {
      width: 64px; height: 64px; border-radius: 50%;
      background: var(--blush); color: var(--pink-deep);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: var(--s5);
    }
    .vacio-icono svg { width: 26px; height: 26px; }
    .vacio-titulo {
      font-family: 'Sloop', cursive; font-size: 2.4rem; line-height: 1.1;
      color: var(--dark); margin-bottom: var(--s3);
    }
    .vacio-texto {
      font-size: 0.9rem; color: var(--gray); line-height: 1.7;
      max-width: 30ch; margin-bottom: var(--s6);
    }
    .vacio-boton {
      font-family: inherit; font-size: 0.72rem; letter-spacing: 0.18em;
      text-transform: uppercase; color: #fff; background: var(--dark);
      border: none; border-radius: 100px; padding: 0.95rem 2.2rem; cursor: pointer;
      transition: transform 0.2s, opacity 0.2s;
    }
    .vacio-boton:active { transform: scale(0.97); }

    /* ── BOTÓN FLOTANTE: la acción principal, siempre a mano ─────────
       Sin fondo: en iOS 26 la barra de Safari es transparente y la
       rejilla se ve a través; un degradado aquí queda como una franja
       crema flotando por encima de la barra. La sombra ya lo despega. */
    .fab-zona {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 120;
      display: flex; justify-content: center;
      padding: var(--s3) var(--s4) calc(var(--s3) + env(safe-area-inset-bottom, 0px));
      pointer-events: none;
    }
    .fab {
      pointer-events: auto;
      display: inline-flex; align-items: center; gap: 0.55rem;
      font-family: inherit; font-size: 0.74rem; letter-spacing: 0.16em;
      text-transform: uppercase; color: #fff; background: var(--dark);
      border: none; border-radius: 100px; padding: 1rem 1.9rem; cursor: pointer;
      box-shadow: 0 6px 24px rgba(40,20,28,0.22), 0 2px 6px rgba(40,20,28,0.12);
      transition: transform 0.2s cubic-bezier(0.2,0.8,0.2,1), box-shadow 0.2s;
      -webkit-tap-highlight-color: transparent;
    }
    .fab:active { transform: scale(0.96); }
    .fab svg { width: 17px; height: 17px; }
    .fab[hidden] { display: none !important; }

    /* Barra de progreso, ocupa el sitio del FAB mientras sube */
    .progreso {
      pointer-events: auto; width: 100%; max-width: 460px;
      background: #fff; border: 1px solid var(--border); border-radius: 16px;
      padding: var(--s3) var(--s4); box-shadow: 0 6px 24px rgba(40,20,28,0.14);
    }
    .progreso[hidden] { display: none !important; }
    .progreso-fila { display: flex; align-items: center; justify-content: space-between; gap: var(--s3); }
    .progreso-texto { font-size: 0.76rem; color: var(--dark); letter-spacing: 0.02em; }
    .progreso-texto.error { color: var(--err); }
    .progreso-barra { height: 3px; background: var(--border); border-radius: 100px; overflow: hidden; margin-top: var(--s2); }
    .progreso-barra span { display: block; height: 100%; width: 0; background: var(--pink-deep); border-radius: 100px; transition: width 0.35s ease; }
    .progreso-motivo {
      margin-top: var(--s2); font-size: 0.7rem; line-height: 1.45;
      color: var(--err); opacity: 0.9;
    }
    .progreso-motivo[hidden] { display: none !important; }
    .progreso-accion {
      flex: none; font-family: inherit; font-size: 0.62rem; letter-spacing: 0.12em;
      text-transform: uppercase; background: none; border: none; cursor: pointer;
      color: var(--pink-deep); text-decoration: underline; text-underline-offset: 3px;
      padding: 0.2rem 0;
    }
    .progreso-accion[hidden] { display: none !important; }
    #progresoParar { color: var(--gray); }

    /* ── HOJA INFERIOR: pide el nombre una sola vez ────────────────── */
    .velo {
      position: fixed; inset: 0; z-index: 200; background: rgba(26,18,22,0.45);
      backdrop-filter: blur(3px); opacity: 0; pointer-events: none; transition: opacity 0.3s;
    }
    .velo.abierto { opacity: 1; pointer-events: auto; }
    .hoja {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 210;
      background: var(--cream); border-radius: 22px 22px 0 0;
      padding: var(--s5) var(--s5) calc(var(--s6) + env(safe-area-inset-bottom, 0px));
      transform: translateY(102%); transition: transform 0.36s cubic-bezier(0.2, 0.9, 0.2, 1);
      box-shadow: 0 -8px 40px rgba(40,20,28,0.18);
    }
    .hoja.abierta { transform: none; }
    @media (min-width: 640px) {
      .hoja { left: 50%; right: auto; bottom: 50%; width: min(420px, 92vw);
              transform: translate(-50%, 60%) scale(0.96); border-radius: 18px; opacity: 0; }
      .hoja.abierta { transform: translate(-50%, 50%) scale(1); opacity: 1; }
    }
    .hoja-tirador { width: 36px; height: 4px; border-radius: 100px; background: var(--rose); margin: 0 auto var(--s5); }
    @media (min-width: 640px) { .hoja-tirador { display: none; } }
    .hoja-titulo {
      font-family: 'Sloop', cursive; font-size: 2.1rem; line-height: 1.1;
      color: var(--dark); text-align: center; margin-bottom: var(--s2);
    }
    .hoja-texto { font-size: 0.84rem; color: var(--gray); text-align: center; margin-bottom: var(--s5); line-height: 1.6; }
    .hoja-input {
      width: 100%; background: #fff; border: 1px solid var(--border); border-radius: 12px;
      color: var(--dark); font-family: inherit; font-size: 1rem; font-weight: 300;
      padding: 0.9rem 1rem; margin-bottom: var(--s4); text-align: center;
    }
    .hoja-input:focus { outline: none; border-color: var(--pink); }
    .hoja-boton {
      width: 100%; font-family: inherit; font-size: 0.74rem; letter-spacing: 0.18em;
      text-transform: uppercase; color: #fff; background: var(--dark);
      border: none; border-radius: 100px; padding: 1rem; cursor: pointer;
    }
    .hoja-boton:disabled { opacity: 0.35; }
    .hoja-input[hidden] { display: none !important; }

    /* ── ELEGIR CALIDAD ────────────────────────────────────────────
       Se enseña cada vez que se eligen fotos, no una sola vez: la cobertura
       cambia a lo largo del día y aquí se ve lo que va a pesar la subida
       ANTES de lanzarla. */
    .calidad { display: flex; flex-direction: column; gap: var(--s2); margin-bottom: var(--s4); }
    .calidad[hidden] { display: none !important; }
    .calidad-titulo {
      font-size: 0.58rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--gray); text-align: center; margin-bottom: var(--s1);
    }
    .opcion {
      display: flex; align-items: flex-start; gap: var(--s3); width: 100%;
      font-family: inherit; text-align: left; cursor: pointer;
      background: #fff; border: 1px solid var(--border); border-radius: 14px;
      padding: 0.85rem 0.95rem; transition: border-color 0.2s, background 0.2s;
    }
    .opcion[aria-checked="true"] { border-color: var(--pink); background: #fffdfb; }
    .opcion-marca {
      flex: none; width: 17px; height: 17px; margin-top: 2px; border-radius: 50%;
      border: 1.5px solid var(--rose); position: relative;
    }
    .opcion[aria-checked="true"] .opcion-marca { border-color: var(--pink-deep); }
    .opcion[aria-checked="true"] .opcion-marca::after {
      content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--pink-deep);
    }
    .opcion-cuerpo { display: flex; flex-direction: column; gap: 0.18rem; min-width: 0; }
    .opcion-nombre { font-size: 0.88rem; font-weight: 400; color: var(--dark); }
    .opcion-detalle { font-size: 0.72rem; line-height: 1.5; color: var(--gray); }
    .opcion-peso { font-size: 0.68rem; color: var(--pink-deep); letter-spacing: 0.04em; }
    .calidad-aviso {
      font-size: 0.7rem; line-height: 1.5; color: var(--pink-deep);
      text-align: center; margin-top: var(--s1);
    }
    .calidad-aviso[hidden] { display: none !important; }

    /* ── VISOR ─────────────────────────────────────────────────────── */
    .visor {
      position: fixed; inset: 0; z-index: 300; display: none;
      background: rgba(12,6,9,0.97); flex-direction: column;
      touch-action: pan-y;
    }
    .visor.abierto { display: flex; animation: aparecer 0.25s ease both; }
    @keyframes aparecer { from { opacity: 0 } to { opacity: 1 } }
    /* min-height:0 es lo que deja que la foto encoja: sin esto el contenido
       fuerza el alto del flex y la tira se sale de la pantalla. */
    .visor-escena {
      position: relative; flex: 1; min-height: 0; width: 100%; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    /* Alto DEFINIDO (100% de una escena que ya lo tiene), no automático: con
       alto automático el `max-height:100%` de la foto es circular, el navegador
       lo ignora y la imagen desborda por debajo tapando la tira y el pie. */
    #visorSlot {
      height: 100%; width: 100%; min-width: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .visor img, .visor video { max-width: 100%; max-height: 100%; object-fit: contain; }
    .visor-cerrar, .visor-ant, .visor-sig {
      position: absolute; background: rgba(255,255,255,0.1); backdrop-filter: blur(8px);
      border: none; color: #fff; cursor: pointer; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.2s;
    }
    .visor-cerrar:hover, .visor-ant:hover, .visor-sig:hover { background: rgba(255,255,255,0.22); }
    .visor-cerrar { top: calc(var(--s4) + env(safe-area-inset-top, 0px)); right: var(--s4); width: 38px; height: 38px; font-size: 1.1rem; }
    .visor-ant, .visor-sig { top: 50%; transform: translateY(-50%); width: 42px; height: 42px; font-size: 1.5rem; }
    .visor-ant { left: var(--s3); } .visor-sig { right: var(--s3); }
    @media (max-width: 640px) { .visor-ant, .visor-sig { display: none; } }
    .visor-pie {
      flex: none; text-align: center;
      padding: var(--s3) var(--s4) calc(var(--s4) + env(safe-area-inset-bottom, 0px));
      color: rgba(255,255,255,0.8); font-size: 0.74rem; letter-spacing: 0.1em;
      display: flex; flex-direction: column; gap: var(--s2); align-items: center;
    }
    .visor-pos { font-size: 0.6rem; letter-spacing: 0.16em; color: rgba(255,255,255,0.45); }

    /* ── TIRA DE MINIATURAS ────────────────────────────────────────
       Las imágenes son las MISMAS que las de la rejilla, así que salen del
       caché del navegador: la tira no cuesta ni una petición. */
    .visor-tira {
      flex: none; display: flex; gap: 6px; overflow-x: auto; overflow-y: hidden;
      padding: var(--s2) var(--s4); scrollbar-width: none;
      /* La galería entera está en `pan-y` para que deslizar cambie de foto.
         Aquí hace falta lo contrario, o la tira no se puede recorrer. */
      touch-action: pan-x;
      -webkit-overflow-scrolling: touch;
    }
    .visor-tira::-webkit-scrollbar { display: none; }
    .visor-tira[hidden] { display: none !important; }
    .tira-item {
      flex: none; width: 46px; height: 46px; padding: 0; border: none; cursor: pointer;
      border-radius: 7px; overflow: hidden; background: rgba(255,255,255,0.08);
      opacity: 0.45; transition: opacity 0.2s, outline-color 0.2s;
      outline: 1.5px solid transparent; outline-offset: -1.5px;
    }
    .tira-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .tira-item.activa { opacity: 1; outline-color: #fff; }
    @media (min-width: 640px) {
      .tira-item { width: 58px; height: 58px; }
      .visor-tira { justify-content: safe center; padding-bottom: var(--s3); }
    }
    .visor-borrar {
      font-family: inherit; font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase;
      background: none; border: none; color: rgba(255,255,255,0.55); cursor: pointer;
      text-decoration: underline; text-underline-offset: 3px;
    }
    .visor-borrar[hidden] { display: none !important; }
    .visor-acciones { display: flex; align-items: center; justify-content: center; gap: var(--s4); }
    .visor-descargar {
      font-family: inherit; font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase;
      display: inline-flex; align-items: center; gap: 0.4rem;
      background: rgba(255,255,255,0.12); backdrop-filter: blur(8px);
      border: none; border-radius: 100px; color: #fff; cursor: pointer;
      padding: 0.55rem 1.1rem; transition: background 0.2s;
    }
    .visor-descargar:hover { background: rgba(255,255,255,0.24); }
    .visor-descargar:disabled { opacity: 0.6; cursor: default; }
    .visor-descargar svg { width: 13px; height: 13px; }

    /* ── AVISO FLOTANTE ────────────────────────────────────────────── */
    .aviso {
      position: fixed; left: 50%; transform: translate(-50%, -20px); z-index: 250;
      top: calc(var(--nav-h) + var(--s3));
      background: var(--dark); color: #fff; border-radius: 100px;
      padding: 0.65rem 1.3rem; font-size: 0.76rem; letter-spacing: 0.04em;
      box-shadow: 0 6px 24px rgba(40,20,28,0.25);
      opacity: 0; pointer-events: none; transition: opacity 0.3s, transform 0.3s;
      max-width: 90vw; text-align: center;
    }
    .aviso.visible { opacity: 1; transform: translate(-50%, 0); }

    @keyframes entrar {
      from { opacity: 0; transform: translateY(10px) scale(0.98); }
      to { opacity: 1; transform: none; }
    }

    /* ── PRE-BODA ──────────────────────────────────────────────────── */
    .pre { min-height: calc(100dvh - var(--nav-h)); display: flex; flex-direction: column;
           align-items: center; justify-content: center; text-align: center; padding: var(--s8) var(--s5); }
    .pre-titulo { font-family: 'Sloop', cursive; font-size: clamp(2.8rem, 8vw, 5rem); color: var(--dark); line-height: 1.1; margin-bottom: var(--s4); }
    .pre-deco { width: 40px; height: 1px; background: var(--rose); margin: 0 auto var(--s6); }
    .pre-texto { font-size: 0.9rem; color: var(--gray); line-height: 1.9; max-width: 34ch; margin-bottom: var(--s7); }
    .cuenta { display: flex; align-items: flex-start; justify-content: center; gap: var(--s4); margin-bottom: var(--s6); }
    .cuenta-bloque { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; min-width: 54px; }
    .cuenta-num { font-size: clamp(1.8rem, 8vw, 2.8rem); font-weight: 200; color: var(--dark); line-height: 1; }
    .cuenta-etiqueta { font-size: 0.52rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gray); }
    .pre-insignia { font-size: 0.62rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--pink-deep); border: 1px solid var(--rose); padding: 0.45rem 1.4rem; border-radius: 100px; }
  </style>
</head>
<body>

  <nav class="barra">
    <a href="/" class="barra-atras">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Inicio
    </a>
    <span class="barra-titulo">Fotos</span>
    <span class="barra-vivo" id="vivo"><span class="punto"></span><span id="vivoTexto">En directo</span></span>
  </nav>

  <!-- PRE-BODA -->
  <div id="preBoda" hidden>
    <div class="pre">
      <h2 class="pre-titulo">Las fotos del día</h2>
      <div class="pre-deco"></div>
      <p class="pre-texto">La galería se abre el día de la boda.<br/>Vuelve el 12 de septiembre.</p>
      <div class="cuenta">
        <div class="cuenta-bloque"><span class="cuenta-num" id="cdDias">—</span><span class="cuenta-etiqueta">días</span></div>
        <div class="cuenta-bloque"><span class="cuenta-num" id="cdHoras">—</span><span class="cuenta-etiqueta">horas</span></div>
        <div class="cuenta-bloque"><span class="cuenta-num" id="cdMins">—</span><span class="cuenta-etiqueta">min</span></div>
        <div class="cuenta-bloque"><span class="cuenta-num" id="cdSegs">—</span><span class="cuenta-etiqueta">seg</span></div>
      </div>
      <span class="pre-insignia">12 · 09 · 2026</span>
    </div>
  </div>

  <!-- GALERÍA -->
  <div id="postBoda" hidden>
    <div class="pestanas" id="pestanas" role="tablist">
      <!-- Invitados es fija; el resto se construye con las categorías que
           los novios tengan creadas y que además tengan fotos. -->
      <button class="pestana activa" data-cat="invitados" role="tab" aria-selected="true">Invitados</button>
    </div>

    <div class="rejilla-envoltorio">
      <div class="rejilla" id="rejilla"></div>

      <div class="vacio" id="vacio">
        <div class="vacio-icono">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3Z"/>
            <circle cx="12" cy="13" r="3.2"/>
          </svg>
        </div>
        <h2 class="vacio-titulo" id="vacioTitulo">Empieza tú</h2>
        <p class="vacio-texto" id="vacioTexto">Todavía no hay ninguna foto. Sube la primera y ábrele el álbum a todos.</p>
        <button class="vacio-boton" id="vacioBoton">Añadir mis fotos</button>
      </div>
    </div>
  </div>

  <!-- ACCIÓN PRINCIPAL -->
  <div class="fab-zona" id="fabZona" hidden>
    <button class="fab" id="fab" aria-label="Añadir fotos y vídeos">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3Z"/>
        <circle cx="12" cy="13" r="3.2"/>
      </svg>
      Añadir fotos
    </button>

    <div class="progreso" id="progreso" hidden>
      <div class="progreso-fila">
        <span class="progreso-texto" id="progresoTexto"></span>
        <span style="display:flex;gap:.7rem;flex:none">
          <button class="progreso-accion" id="progresoAccion" hidden></button>
          <button class="progreso-accion" id="progresoParar" hidden>Parar</button>
        </span>
      </div>
      <div class="progreso-barra"><span id="progresoBarra"></span></div>
      <p class="progreso-motivo" id="progresoMotivo" hidden></p>
    </div>
  </div>

  <input type="file" id="selector" accept="image/*,video/*" multiple hidden />

  <!-- NOMBRE (una sola vez) -->
  <div class="velo" id="velo"></div>
  <div class="hoja" id="hoja" role="dialog" aria-modal="true" aria-labelledby="hojaTitulo">
    <div class="hoja-tirador"></div>
    <h2 class="hoja-titulo" id="hojaTitulo">¿Quién eres?</h2>
    <p class="hoja-texto" id="hojaTexto">Para que Aimar y Deborah sepan de quién es cada foto.</p>
    <input class="hoja-input" type="text" id="nombreInput" placeholder="Tu nombre" autocomplete="name" enterkeyhint="done" />

    <div class="calidad" id="calidad" role="radiogroup" aria-label="Calidad de subida">
      <span class="calidad-titulo">Cómo subirlas</span>
      <button class="opcion" type="button" id="opcOriginal" role="radio" data-calidad="original" aria-checked="true">
        <span class="opcion-marca"></span>
        <span class="opcion-cuerpo">
          <span class="opcion-nombre">Calidad original</span>
          <span class="opcion-detalle">La foto tal cual la hizo tu móvil, para guardar e imprimir.</span>
          <span class="opcion-peso" id="pesoOriginal"></span>
        </span>
      </button>
      <button class="opcion" type="button" id="opcLigera" role="radio" data-calidad="ligera" aria-checked="false">
        <span class="opcion-marca"></span>
        <span class="opcion-cuerpo">
          <span class="opcion-nombre">Más ligera</span>
          <span class="opcion-detalle">En la galería se ve igual, pero sin copia original descargable.</span>
          <span class="opcion-peso" id="pesoLigera"></span>
        </span>
      </button>
      <p class="calidad-aviso" id="calidadAviso" hidden></p>
    </div>

    <button class="hoja-boton" id="hojaBoton">Continuar</button>
  </div>

  <!-- VISOR -->
  <div class="visor" id="visor" role="dialog" aria-modal="true">
    <button class="visor-cerrar" id="visorCerrar" aria-label="Cerrar">✕</button>
    <div class="visor-escena" id="visorEscena">
      <button class="visor-ant" id="visorAnt" aria-label="Anterior">‹</button>
      <div id="visorSlot"></div>
      <button class="visor-sig" id="visorSig" aria-label="Siguiente">›</button>
    </div>
    <div class="visor-tira" id="visorTira" role="tablist" aria-label="Todas las fotos" hidden></div>
    <div class="visor-pie">
      <span class="visor-pos" id="visorPos"></span>
      <span id="visorQuien"></span>
      <div class="visor-acciones">
        <button class="visor-descargar" id="visorDescargar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span id="visorDescargarTexto">Descargar</span>
        </button>
        <button class="visor-borrar" id="visorBorrar" hidden>Borrar mi foto</button>
      </div>
    </div>
  </div>

  <div class="aviso" id="aviso"></div>

<script>
  import { procesar, ErrorMedio } from '../lib/media';
  import type { Calidad } from '../lib/media';
  import { ColaSubida } from '../lib/uploadQueue';

  const API = import.meta.env.PUBLIC_API_BASE ?? '';
  const $ = (id: string) => document.getElementById(id)!;

  // Galería abierta desde ya. Para cerrarla hasta el día de la boda:
  //   const APERTURA = new Date('2026-09-12T00:00:00+02:00');
  const APERTURA: Date | null = null;
  const abierta = APERTURA === null || new Date() >= APERTURA;

  $('preBoda').hidden = abierta;
  $('postBoda').hidden = !abierta;
  $('fabZona').hidden = !abierta;

  if (!abierta && APERTURA) {
    const tick = () => {
      const diff = APERTURA.getTime() - Date.now();
      if (diff <= 0) { location.reload(); return; }
      const p = (n: number) => String(n).padStart(2, '0');
      $('cdDias').textContent  = String(Math.floor(diff / 86400000));
      $('cdHoras').textContent = p(Math.floor((diff % 86400000) / 3600000));
      $('cdMins').textContent  = p(Math.floor((diff % 3600000) / 60000));
      $('cdSegs').textContent  = p(Math.floor((diff % 60000) / 1000));
    };
    tick(); setInterval(tick, 1000);
  } else {
    arrancar();
  }

  interface Item {
    id: string; tipo: 'foto' | 'video'; categoria: string | null;
    nombre: string; deviceHash: string;
    thumb: string; web: string; poster: string | null;
    /** Copia tal cual salió del móvil. null si se subió en modo ligero. */
    original: string | null;
    duracion: number | null; ancho: number; alto: number; ts: number;
  }

  function arrancar() {
    const rejilla = $('rejilla');
    const vacio = $('vacio');
    const contenedorPestanas = $('pestanas');

    let cat = 'invitados';
    let invitados: Item[] = [];
    let oficiales: Item[] = [];
    let categorias: { slug: string; nombre: string }[] = [];
    let columnas: HTMLElement[] = [];
    let numColumnas = 0;
    const nodos = new Map<string, HTMLElement>();

    const deviceId = localStorage.getItem('ad-device') ?? crypto.randomUUID();
    localStorage.setItem('ad-device', deviceId);
    let miNombre = localStorage.getItem('ad-nombre') ?? '';

    // Misma huella que calcula el Worker. El índice solo publica huellas, así
    // que nadie puede leer el identificador de otro y borrarle las fotos.
    let miHuella = '';
    (async () => {
      const datos = new TextEncoder().encode(`ad-galeria:${deviceId}`);
      const hash = await crypto.subtle.digest('SHA-256', datos);
      miHuella = Array.from(new Uint8Array(hash)).slice(0, 12)
        .map((b) => b.toString(16).padStart(2, '0')).join('');
      pintar();   // repintar para marcar las propias
    })();

    const esMia = (item: Item) => Boolean(miHuella) && item.deviceHash === miHuella;

    // Arranca visible a propósito: el botón de subir es la acción principal y
    // no puede depender de que llegue el índice. Con mala cobertura, un
    // invitado se quedaría mirando una página sin forma de añadir nada.
    let mostrandoVacio = false;
    let subiendo = false;

    /** Se aparta solo cuando manda el botón grande del estado vacío o cuando
        la barra de progreso ocupa su sitio: nunca dos botones iguales. */
    function sincronizarFab() {
      const fabEl = document.getElementById('fab') as HTMLElement | null;
      if (!fabEl) return;
      fabEl.hidden = subiendo || mostrandoVacio;
    }

    const visibles = (): Item[] =>
      cat === 'invitados' ? invitados
      : cat === 'todas' ? oficiales
      : oficiales.filter((i) => i.categoria === cat);

    // ── AVISOS ────────────────────────────────────────────────────
    let avisoTimer: number;
    function avisar(texto: string) {
      const el = $('aviso');
      el.textContent = texto;
      el.classList.add('visible');
      clearTimeout(avisoTimer);
      avisoTimer = window.setTimeout(() => el.classList.remove('visible'), 3600);
    }

    // ── REJILLA ───────────────────────────────────────────────────
    function columnasParaAncho(): number {
      const w = window.innerWidth;
      if (w >= 1200) return 5;
      if (w >= 900) return 4;
      if (w >= 560) return 3;
      return 2;
    }

    function crearTarjeta(item: Item): HTMLElement {
      const b = document.createElement('button');
      b.className = 'tarjeta';
      b.type = 'button';
      b.dataset.id = item.id;
      if (item.ancho && item.alto) b.style.aspectRatio = `${item.ancho} / ${item.alto}`;
      if (esMia(item)) b.classList.add('tarjeta-mia');

      const img = document.createElement('img');
      img.src = item.tipo === 'video' ? (item.poster ?? item.thumb) : item.thumb;
      img.loading = 'lazy';
      img.decoding = 'async';
      img.alt = item.nombre ? `Foto de ${item.nombre}` : 'Foto de la boda';
      b.appendChild(img);

      if (item.tipo === 'video') {
        const ins = document.createElement('span');
        ins.className = 'insignia';
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('viewBox', '0 0 24 24');
        svg.setAttribute('fill', 'currentColor');
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', 'M8 5v14l11-7z');
        svg.appendChild(path);
        ins.appendChild(svg);
        if (item.duracion) ins.appendChild(document.createTextNode(`${Math.round(item.duracion)}s`));
        b.appendChild(ins);
      }

      if (item.nombre) {
        const quien = document.createElement('span');
        quien.className = 'tarjeta-quien';
        quien.textContent = esMia(item) ? `${item.nombre} · tuya` : item.nombre;
        b.appendChild(quien);
      }

      b.addEventListener('click', () => abrirVisor(item.id));
      return b;
    }

    /** Reparte en columnas reales, en orden. La más nueva queda arriba a la izquierda. */
    function pintar() {
      const items = visibles();
      const n = columnasParaAncho();

      if (n !== numColumnas) {
        numColumnas = n;
        rejilla.replaceChildren();
        columnas = Array.from({ length: n }, () => {
          const c = document.createElement('div');
          c.className = 'columna';
          rejilla.appendChild(c);
          return c;
        });
      }

      const vistos = new Set<string>();
      items.forEach((item, i) => {
        vistos.add(item.id);
        let nodo = nodos.get(item.id);
        if (!nodo) {
          nodo = crearTarjeta(item);
          nodos.set(item.id, nodo);
        } else {
          nodo.style.animation = 'none';   // ya estaba: que no vuelva a entrar
        }
        // Re-anexar un nodo existente lo mueve sin recargar la imagen
        columnas[i % n]!.appendChild(nodo);
      });

      for (const [id, nodo] of nodos) {
        if (!vistos.has(id)) { nodo.remove(); nodos.delete(id); }
      }

      const sinFotos = items.length === 0;
      vacio.classList.toggle('visible', sinFotos);
      rejilla.style.display = sinFotos ? 'none' : 'flex';
      mostrandoVacio = sinFotos && cat === 'invitados';
      sincronizarFab();

      if (cat === 'invitados') {
        $('vacioTitulo').textContent = 'Empieza tú';
        $('vacioTexto').textContent = 'Todavía no hay ninguna foto. Sube la primera y ábrele el álbum a todos.';
        ($('vacioBoton') as HTMLElement).hidden = false;
      } else {
        $('vacioTitulo').textContent = 'Muy pronto';
        $('vacioTexto').textContent = 'Cuando el fotógrafo entregue el reportaje, aparecerá aquí.';
        ($('vacioBoton') as HTMLElement).hidden = true;
      }

      const vivo = $('vivo');
      if (cat === 'invitados' && items.length) {
        $('vivoTexto').textContent = `${items.length}`;
        vivo.classList.add('visible');
      } else {
        vivo.classList.remove('visible');
      }
    }

    let anchoPrevio = window.innerWidth;
    addEventListener('resize', () => {
      if (columnasParaAncho() !== numColumnas || Math.abs(window.innerWidth - anchoPrevio) > 80) {
        anchoPrevio = window.innerWidth;
        pintar();
      }
    });

    // ── VISOR ─────────────────────────────────────────────────────
    const visor = $('visor');
    const slot = $('visorSlot');
    let visorId: string | null = null;

    const tira = $('visorTira');
    const nodosTira = new Map<string, HTMLElement>();
    let tiraFirma = '';

    /**
     * Tira de miniaturas del visor.
     *
     * Usa las MISMAS imágenes que la rejilla, así que sale entera del caché del
     * navegador: no cuesta ni una petición. Está para saber dónde estás dentro
     * del álbum y para saltar varias fotos de golpe, que con 50 fotos deslizar
     * una a una se hace largo.
     */
    function pintarTira(instantaneo = false) {
      const items = visibles();
      (tira as HTMLElement).hidden = items.length < 2;
      if (items.length < 2) return;

      // Se reconstruye solo si ha cambiado la lista: llegan fotos nuevas cada
      // 30 s, y rehacerla en cada repintado perdería la posición del scroll y
      // volvería a montar 50 nodos por nada.
      const firma = items.map((i) => i.id).join(',');
      if (firma !== tiraFirma) {
        tiraFirma = firma;
        nodosTira.clear();
        tira.replaceChildren();
        for (const it of items) {
          const b = document.createElement('button');
          b.className = 'tira-item';
          b.type = 'button';
          b.setAttribute('role', 'tab');
          b.setAttribute('aria-label', it.nombre ? `Foto de ${it.nombre}` : 'Foto de la boda');
          const img = document.createElement('img');
          img.src = it.thumb;
          img.loading = 'lazy';
          img.decoding = 'async';
          img.alt = '';
          b.appendChild(img);
          b.addEventListener('click', () => { visorId = it.id; pintarVisor(); });
          tira.appendChild(b);
          nodosTira.set(it.id, b);
        }
      }

      for (const [id, nodo] of nodosTira) {
        const activa = id === visorId;
        nodo.classList.toggle('activa', activa);
        nodo.setAttribute('aria-selected', String(activa));
        if (!activa) continue;
        // Centrado a mano en vez de scrollIntoView: ese además arrastra a los
        // ancestros, y aquí el ancestro es la página entera detrás del visor.
        // Al abrir se coloca de golpe; al pasar de foto, con animación.
        const centro = nodo.offsetLeft + nodo.offsetWidth / 2 - tira.clientWidth / 2;
        tira.scrollTo({ left: Math.max(0, centro), behavior: instantaneo ? 'auto' : 'smooth' });
      }
    }

    function abrirVisor(id: string) {
      visorId = id;
      // El orden importa: sobre un elemento en display:none no se puede hacer
      // scroll, y la tira se quedaba clavada en la primera foto.
      visor.classList.add('abierto');
      document.body.style.overflow = 'hidden';
      pintarVisor(true);
    }
    function cerrarVisor() {
      visor.classList.remove('abierto');
      slot.replaceChildren();
      document.body.style.overflow = '';
      visorId = null;
    }
    function pintarVisor(instantaneo = false) {
      const items = visibles();
      const item = items.find((i) => i.id === visorId);
      if (!item) { cerrarVisor(); return; }
      // «12 / 53»: con 50 fotos, deslizar sin saber cuántas quedan es a ciegas.
      const puesto = items.indexOf(item) + 1;
      $('visorPos').textContent = items.length > 1 ? `${puesto} / ${items.length}` : '';
      slot.replaceChildren();
      if (item.tipo === 'video') {
        const v = document.createElement('video');
        v.src = item.web; v.controls = true; v.autoplay = true;
        v.playsInline = true; v.poster = item.poster ?? '';
        slot.appendChild(v);
      } else {
        const img = document.createElement('img');
        img.src = item.web;
        img.alt = item.nombre ? `Foto de ${item.nombre}` : 'Foto de la boda';
        slot.appendChild(img);
      }
      $('visorQuien').textContent = item.nombre ?? '';
      ($('visorBorrar') as HTMLElement).hidden = !esMia(item);
      // Se dice QUÉ se descarga: las subidas en modo ligero no tienen original,
      // y prometer uno que no existe es peor que no ofrecerlo.
      $('visorDescargarTexto').textContent =
        item.tipo === 'video' ? 'Descargar vídeo'
        : item.original ? 'Descargar original'
        : 'Descargar';
      pintarTira(instantaneo);
    }

    /**
     * Descarga la mejor versión disponible: el original si se subió, y si no la
     * versión web (que también da para imprimir en 20x30).
     *
     * No sirve un <a download> apuntando al bucket: el atributo `download` se
     * IGNORA entre dominios distintos, y los medios viven en otro dominio, así
     * que el navegador abriría la foto en lugar de guardarla. Hay que traerse
     * los bytes y crear un blob del propio origen.
     *
     * En el móvil se intenta primero la hoja de compartir: es la única vía por
     * la que la foto acaba en el carrete y no en una carpeta de descargas.
     */
    async function descargar(item: Item): Promise<void> {
      const url = item.original ?? item.web;
      const ext = url.split('?')[0]!.split('.').pop() || 'jpg';
      const quien = (item.nombre || 'boda').replace(/[^\p{L}\p{N}]+/gu, '-').toLowerCase();
      const nombre = `AimarDeborah-${quien}-${item.id.slice(0, 8)}.${ext}`;

      const res = await fetch(url);
      if (!res.ok) throw new Error(String(res.status));
      const blob = await res.blob();

      const archivo = new File([blob], nombre, { type: blob.type || 'application/octet-stream' });
      if (navigator.canShare?.({ files: [archivo] })) {
        try {
          await navigator.share({ files: [archivo] });
          return;
        } catch (err) {
          // Cerrar la hoja de compartir no es un fallo. Cualquier otro motivo
          // (iOS la bloquea si ha pasado mucho desde el toque) cae a la
          // descarga normal, que siempre funciona.
          if ((err as Error)?.name === 'AbortError') return;
        }
      }

      const href = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = href;
      a.download = nombre;
      a.click();
      setTimeout(() => URL.revokeObjectURL(href), 20_000);
    }

    $('visorDescargar').addEventListener('click', async () => {
      const item = visibles().find((i) => i.id === visorId);
      if (!item) return;

      const boton = $('visorDescargar') as HTMLButtonElement;
      const etiqueta = $('visorDescargarTexto');
      const antes = etiqueta.textContent ?? 'Descargar';
      boton.disabled = true;
      etiqueta.textContent = 'Preparando…';
      try {
        await descargar(item);
      } catch {
        avisar('No se pudo descargar. Inténtalo de nuevo.');
      } finally {
        boton.disabled = false;
        etiqueta.textContent = antes;
      }
    });
    function paso(dir: number) {
      const items = visibles();
      const i = items.findIndex((x) => x.id === visorId);
      if (i < 0) return;
      visorId = items[(i + dir + items.length) % items.length]!.id;
      pintarVisor();
    }

    $('visorCerrar').addEventListener('click', cerrarVisor);
    $('visorAnt').addEventListener('click', () => paso(-1));
    $('visorSig').addEventListener('click', () => paso(1));
    // El hueco alrededor de la foto ya no es el propio visor: con la tira
    // debajo, la foto vive dentro de `.visor-escena`.
    visor.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === visor || t.id === 'visorEscena' || t.id === 'visorSlot') cerrarVisor();
    });
    document.addEventListener('keydown', (e) => {
      if (!visor.classList.contains('abierto')) return;
      if (e.key === 'Escape') cerrarVisor();
      if (e.key === 'ArrowLeft') paso(-1);
      if (e.key === 'ArrowRight') paso(1);
    });
    let x0 = 0, y0 = 0, gestoValido = false;
    visor.addEventListener('touchstart', (e) => {
      // Recorrer la tira es un gesto horizontal igual que pasar de foto: si no
      // se distinguen, arrastrar la tira salta tres imágenes de golpe.
      gestoValido = !(e.target as HTMLElement).closest?.('.visor-tira');
      x0 = e.touches[0]!.clientX; y0 = e.touches[0]!.clientY;
    }, { passive: true });
    visor.addEventListener('touchend', (e) => {
      if (!gestoValido) return;
      const dx = e.changedTouches[0]!.clientX - x0;
      const dy = e.changedTouches[0]!.clientY - y0;
      if (Math.abs(dy) > 90 && Math.abs(dy) > Math.abs(dx)) { cerrarVisor(); return; }
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) paso(dx < 0 ? 1 : -1);
    }, { passive: true });

    $('visorBorrar').addEventListener('click', async () => {
      const id = visorId;
      if (!id || !confirm('¿Quitar esta foto de la galería?')) return;

      const boton = $('visorBorrar') as HTMLButtonElement;
      boton.disabled = true;
      boton.textContent = 'Quitando…';

      // Nada de quitarla de la pantalla antes de tiempo: si el servidor no lo
      // confirma, al recargar volvería a aparecer y el aviso habría mentido.
      try {
        const res = await fetch(`${API}/borrar`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, deviceId }),
        });
        if (!res.ok) throw new Error(String(res.status));
        invitados = invitados.filter((i) => i.id !== id);
        cerrarVisor();
        pintar();
        avisar('Foto quitada');
      } catch {
        avisar('No se pudo quitar. Inténtalo de nuevo.');
      } finally {
        boton.disabled = false;
        boton.textContent = 'Borrar mi foto';
      }
    });

    // ── PESTAÑAS ──────────────────────────────────────────────────
    function activar(nueva: string) {
      cat = nueva;
      contenedorPestanas.querySelectorAll<HTMLButtonElement>('.pestana').forEach((b) => {
        const suya = b.dataset.cat === nueva;
        b.classList.toggle('activa', suya);
        b.setAttribute('aria-selected', String(suya));
      });
      nodos.forEach((n) => n.remove()); nodos.clear();
      numColumnas = 0;
      pintar();
      scrollTo({ top: 0, behavior: 'smooth' });
    }

    function nuevaPestana(slug: string, nombre: string): HTMLButtonElement {
      const b = document.createElement('button');
      b.className = 'pestana';
      b.type = 'button';
      b.dataset.cat = slug;
      b.setAttribute('role', 'tab');
      b.setAttribute('aria-selected', String(slug === cat));
      if (slug === cat) b.classList.add('activa');
      b.textContent = nombre;   // texto plano: lo escriben los novios
      b.addEventListener('click', () => activar(slug));
      return b;
    }

    /** Solo se enseñan las categorías que tienen fotos: nada de pestañas vacías. */
    function pintarPestanas() {
      const conFotos = categorias.filter((c) => oficiales.some((o) => o.categoria === c.slug));
      const hayOficiales = oficiales.length > 0;

      contenedorPestanas.replaceChildren();
      contenedorPestanas.appendChild(nuevaPestana('invitados', 'Invitados'));
      if (hayOficiales) {
        contenedorPestanas.appendChild(nuevaPestana('todas', 'Reportaje'));
        for (const c of conFotos) contenedorPestanas.appendChild(nuevaPestana(c.slug, c.nombre));
      }
      contenedorPestanas.classList.toggle('visible', hayOficiales);

      // Si la pestaña abierta ha dejado de existir, se vuelve a Invitados.
      const sigue = ['invitados', 'todas'].includes(cat) || conFotos.some((c) => c.slug === cat);
      if (!sigue) activar('invitados');
    }

    // ── DATOS ─────────────────────────────────────────────────────
    // Siempre la MISMA URL, y `no-store` para que el navegador no guarde copia.
    //
    // Sin no-store, Chrome se quedaba con la respuesta y la reservía una y otra
    // vez (repitiendo hasta las cabeceras `age` y `cf-cache-status`), así que un
    // invitado podía subir su foto y no verla aparecer nunca.
    //
    // Esto NO tumba la protección de carga: la petición llega al borde, que
    // sigue sirviendo su copia de 15 s. Lo que se evita es la caché privada del
    // navegador. Y la URL sigue sin cache-buster: un ?t=Date.now() sí saltaría
    // la caché del borde y recrearía el fallo original.
    async function traer(origen: 'invitado' | 'oficial', forzar = false): Promise<Item[] | null> {
      try {
        let url = origen === 'oficial' ? `${API}/indice.json?origen=oficial` : `${API}/indice.json`;
        // `forzar` salta la caché del borde con un parámetro único.
        //
        // OJO: esto SOLO se usa una vez, justo después de subir. En el sondeo
        // periódico sería exactamente el bug que tumbaba la galería con 150
        // invitados. Aquí es una petición por subida, no una cada 15 s por
        // persona, y es lo que hace que tus fotos aparezcan al instante en vez
        // de esperar a que caduque la copia del CDN.
        if (forzar) url += `${url.includes('?') ? '&' : '?'}t=${Date.now()}`;
        const res = await fetch(url, { cache: 'no-store' });
        if (!res.ok) return null;
        const datos = await res.json();
        return Array.isArray(datos.items) ? datos.items : null;
      } catch { return null; }
    }

    async function traerCategorias(): Promise<void> {
      try {
        const res = await fetch(`${API}/categorias.json`, { cache: 'no-store' });
        if (!res.ok) return;
        const d = await res.json();
        if (Array.isArray(d.categorias)) categorias = d.categorias;
      } catch { /* si falla, se queda con las que ya tenía */ }
    }

    // ── Presupuesto de peticiones ─────────────────────────────────────
    // El Worker se EJECUTA en cada petición, aunque la respuesta salga de
    // caché (comprobado con `wrangler tail`: 10 HIT = 10 invocaciones). El plan
    // gratuito son 100.000 al día, y cada sondeo de cada invitado cuenta.
    //
    // Antes: cada 15 s, dos índices, también con la pestaña en segundo plano
    // → 480/hora por invitado; con 30 personas mirando se superaba el límite y
    // el Worker respondería error 1027 hasta medianoche UTC.
    // Ahora: cada 30 s, solo el de invitados, y nada con la pestaña oculta
    // → ~120/hora. El reportaje no cambia durante la boda: se mira al entrar y
    // cada 5 minutos. Las fotos propias siguen apareciendo al instante, porque
    // tras subir se fuerza un refresco aparte.
    const SONDEO_MS = 30_000;
    const OFICIAL_CADA = 10;           // 10 × 30 s = cada 5 minutos
    let vueltas = 0;

    let primeraCarga = true;
    async function refrescar(forzar = false) {
      const conOficial = primeraCarga || forzar || vueltas % OFICIAL_CADA === 0;
      vueltas++;
      const [inv, ofi] = await Promise.all([
        traer('invitado', forzar),
        conOficial ? traer('oficial', forzar) : Promise.resolve(null),
      ]);
      if (primeraCarga || forzar) await traerCategorias();
      const antes = invitados.length;
      // Ante un fallo de red, conservar lo que ya había: nunca vaciar la galería.
      if (inv) invitados = inv;
      if (ofi) oficiales = ofi;

      pintarPestanas();
      pintar();

      if (!primeraCarga && cat === 'invitados' && invitados.length > antes) {
        const nuevas = invitados.length - antes;
        avisar(nuevas === 1 ? 'Una foto nueva' : `${nuevas} fotos nuevas`);
      }
      primeraCarga = false;
    }

    refrescar();
    setInterval(() => {
      // Con la pestaña oculta no se pregunta nada: nadie está mirando.
      if (document.visibilityState === 'visible') refrescar();
    }, SONDEO_MS);
    // Al volver a la pestaña, ponerse al día sin esperar al siguiente turno.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') refrescar();
    });

    // ── SUBIDA ────────────────────────────────────────────────────
    const cola = new ColaSubida(API);
    const selector = $('selector') as HTMLInputElement;
    const progreso = $('progreso') as HTMLElement;
    const hoja = $('hoja');
    const velo = $('velo');
    let pendientes: File[] = [];

    const abrirSelector = () => selector.click();
    $('fab').addEventListener('click', abrirSelector);
    $('vacioBoton').addEventListener('click', abrirSelector);

    // ── CALIDAD DE SUBIDA ─────────────────────────────────────────
    // Por defecto, original: la boda ya ha pasado y lo que se sube ahora se
    // sube para guardarlo. Quien tenga mala conexión lo cambia en un toque, y
    // la elección se recuerda para la próxima vez.
    const LLAVE_CALIDAD = 'ad-calidad';
    let calidad: Calidad = localStorage.getItem(LLAVE_CALIDAD) === 'ligera' ? 'ligera' : 'original';

    const MB = 1024 * 1024;
    // Lo que pesa una versión web ya comprimida: ~0,65 MB en Android (webp) y
    // ~1 MB en iPhone (jpeg, que Safari no sabe evitar). Se estima por lo alto.
    const PESO_WEB = 1 * MB;

    function enMB(bytes: number): string {
      if (bytes >= 1024 * MB) return `${(bytes / (1024 * MB)).toFixed(1)} GB`;
      if (bytes >= MB) return `${Math.round(bytes / MB)} MB`;
      return `${Math.max(1, Math.round(bytes / 1024))} KB`;
    }

    const esVideo = (f: File) => f.type.startsWith('video/');

    /** «8 fotos», «3 fotos y 1 vídeo»… para que se vea qué se va a subir. */
    function resumenSeleccion(): string {
      const fotos = pendientes.filter((f) => !esVideo(f)).length;
      const videos = pendientes.length - fotos;
      const partes: string[] = [];
      if (fotos) partes.push(fotos === 1 ? '1 foto' : `${fotos} fotos`);
      if (videos) partes.push(videos === 1 ? '1 vídeo' : `${videos} vídeos`);
      return partes.join(' y ');
    }

    function textoBoton(): string {
      if (pendientes.length === 1) return esVideo(pendientes[0]!) ? 'Subir el vídeo' : 'Subir la foto';
      return `Subir ${resumenSeleccion()}`;
    }

    /**
     * Pinta las dos opciones con lo que va a pesar cada una.
     *
     * El número importa: en original se suben la versión web Y el archivo
     * entero, así que son ~5 MB por foto en vez de ~1. Verlo antes de lanzar la
     * subida es lo que evita la sorpresa de 200 MB con datos móviles.
     */
    function pintarCalidad() {
      const fotos = pendientes.filter((f) => !esVideo(f));
      const bytesVideo = pendientes.filter(esVideo).reduce((a, f) => a + f.size, 0);
      const ligera = fotos.length * PESO_WEB + bytesVideo;
      const original = ligera + fotos.reduce((a, f) => a + f.size, 0);

      // Sin fotos no hay nada que elegir: el vídeo se sube sin tocar siempre.
      ($('calidad') as HTMLElement).hidden = fotos.length === 0;

      $('pesoOriginal').textContent = `≈ ${enMB(original)} de subida`;
      const veces = ligera > 0 ? Math.round(original / ligera) : 1;
      $('pesoLigera').textContent = veces >= 2
        ? `≈ ${enMB(ligera)} de subida · ${veces} veces más rápido`
        : `≈ ${enMB(ligera)} de subida`;

      for (const id of ['opcOriginal', 'opcLigera']) {
        const el = $(id);
        el.setAttribute('aria-checked', String(el.dataset.calidad === calidad));
      }

      // El navegador sabe si la conexión va mal; no se cambia la elección por
      // su cuenta, solo se avisa.
      const conexion = (navigator as any).connection;
      const lenta = Boolean(conexion) &&
        (conexion.saveData === true || ['slow-2g', '2g', '3g'].includes(conexion.effectiveType));
      const aviso = $('calidadAviso') as HTMLElement;
      if (lenta && calidad === 'original' && fotos.length) {
        aviso.hidden = false;
        aviso.textContent = 'Tu conexión parece lenta. Con «Más ligera» tardarás mucho menos y en la galería se verá igual.';
      } else {
        aviso.hidden = true;
      }
    }

    for (const id of ['opcOriginal', 'opcLigera']) {
      $(id).addEventListener('click', () => {
        calidad = ($(id).dataset.calidad as Calidad) ?? 'original';
        localStorage.setItem(LLAVE_CALIDAD, calidad);
        pintarCalidad();
        ($('hojaBoton') as HTMLButtonElement).textContent = textoBoton();
      });
    }

    function abrirHoja() {
      const input = $('nombreInput') as HTMLInputElement;
      const pideNombre = !miNombre;
      input.value = miNombre;
      input.hidden = !pideNombre;
      $('hojaTitulo').textContent = pideNombre ? '¿Quién eres?' : '¿Las subimos?';
      $('hojaTexto').textContent = pideNombre
        ? 'Para que Aimar y Deborah sepan de quién es cada foto.'
        : resumenSeleccion();
      pintarCalidad();
      ($('hojaBoton') as HTMLButtonElement).textContent = pideNombre ? 'Continuar' : textoBoton();
      velo.classList.add('abierto');
      hoja.classList.add('abierta');
      // El foco solo cuando hace falta escribir: en el móvil el teclado tapa
      // media hoja, y si el nombre ya está puesto no hay nada que teclear.
      if (pideNombre) setTimeout(() => input.focus(), 350);
    }
    function cerrarHoja() {
      velo.classList.remove('abierto');
      hoja.classList.remove('abierta');
    }
    // Cerrar tocando fuera es cancelar: lo elegido no se sube a medias.
    velo.addEventListener('click', () => { pendientes = []; cerrarHoja(); });

    async function confirmar() {
      const input = $('nombreInput') as HTMLInputElement;
      if (!input.hidden) {
        const v = input.value.trim();
        if (!v) { input.focus(); return; }
        miNombre = v;
        localStorage.setItem('ad-nombre', v);
      }
      cerrarHoja();
      await encolar();
    }
    $('hojaBoton').addEventListener('click', confirmar);
    $('nombreInput').addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') confirmar();
    });

    selector.addEventListener('change', async () => {
      pendientes = Array.from(selector.files ?? []);
      selector.value = '';
      if (!pendientes.length) return;
      // La hoja se abre SIEMPRE, no solo la primera vez: es donde se elige la
      // calidad y donde se ve lo que va a pesar la subida antes de lanzarla.
      abrirHoja();
    });

    async function encolar() {
      const archivos = pendientes;
      pendientes = [];
      if (!archivos.length) return;
      if (!API) { avisar('La subida no está configurada.'); return; }

      subiendo = true;
      sincronizarFab();
      progreso.hidden = false;
      $('progresoTexto').textContent = archivos.length === 1 ? 'Preparando la foto…' : `Preparando ${archivos.length} archivos…`;

      const errores: string[] = [];
      for (const archivo of archivos) {
        try {
          const medio = await procesar(archivo, calidad);
          await cola.encolar(medio, miNombre, deviceId);
        } catch (err) {
          errores.push(err instanceof ErrorMedio ? err.message : `No se pudo leer «${archivo.name}».`);
        }
      }
      if (errores.length) avisar(errores[0]!);
    }

    cola.alCambiar((r) => {
      if (!r.total) { progreso.hidden = true; subiendo = false; sincronizarFab(); return; }

      progreso.hidden = false;
      subiendo = true;
      sincronizarFab();
      // La barra avanza con los bytes, no solo al terminar cada foto: con
      // cobertura mala, una foto puede tardar medio minuto y antes la barra
      // no se movía en todo ese rato.
      $('progresoBarra').style.width = `${Math.round(r.fraccion * 100)}%`;

      const texto = $('progresoTexto');
      const accion = $('progresoAccion') as HTMLButtonElement;
      texto.classList.toggle('error', r.fallidos > 0);

      const motivo = $('progresoMotivo') as HTMLElement;

      if (r.hechos === r.total && !r.fallidos) {
        texto.textContent = r.hechos === 1 ? '¡Gracias! Ya está en la galería' : `¡Gracias! ${r.hechos} archivos en la galería`;
        accion.hidden = true;
        // La foto llegó pero su copia original no. No es un fallo (la foto se
        // ve y se puede descargar en versión web), pero hay que decirlo: si
        // no, el invitado creería que tiene guardado un original que no existe.
        if (r.sinOriginal) {
          motivo.hidden = false;
          motivo.textContent = r.sinOriginal === 1
            ? 'En una no se pudo guardar la copia original, pero la foto está subida.'
            : `En ${r.sinOriginal} no se pudo guardar la copia original, pero las fotos están subidas.`;
        } else {
          motivo.hidden = true;
        }
        ($('progresoParar') as HTMLElement).hidden = true;

        // Traer saltando la caché para que las recién subidas aparezcan ya, y
        // subir a verlas: es la confirmación de verdad de que han llegado.
        void refrescar(true).then(() => {
          if (cat === 'invitados') scrollTo({ top: 0, behavior: 'smooth' });
        });
        setTimeout(() => { cola.limpiarHechos(); }, 3500);
        return;
      }

      // El estado tiene que ser honesto: antes, una cola parada esperando
      // cobertura seguía diciendo «Subiendo…» sin dar ninguna pista.
      const cuantas = `${r.hechos} de ${r.total} listas`;
      // Cuando lo único que queda son originales, las fotos YA están en la
      // galería. Decir «Subiendo… 0 de 1» sería falso y llevaría a subirlas
      // otra vez pensando que no han llegado.
      const soloOriginales = r.guardandoOriginal > 0 && r.guardandoOriginal === r.total - r.hechos;
      if (soloOriginales && !r.sinConexion) {
        const pct = r.progresoActual !== undefined ? ` · ${Math.round(r.progresoActual * 100)} %` : '';
        texto.textContent = r.total === 1
          ? `Ya está en la galería · guardando el original${pct}`
          : `Ya están en la galería · guardando los originales${pct}`;
      } else if (r.sinConexion) {
        texto.textContent = `Sin conexión · ${cuantas}`;
      } else if (r.reintentando) {
        texto.textContent = `Reintentando… · ${cuantas}`;
      } else if (r.subiendo) {
        const pct = r.progresoActual !== undefined ? ` · foto ${r.hechos + 1}: ${Math.round(r.progresoActual * 100)} %` : '';
        texto.textContent = `Subiendo… ${cuantas}${pct}`;
      } else if (r.pendientes) {
        texto.textContent = `En cola · ${cuantas}`;
      } else {
        texto.textContent = cuantas;
      }
      if (r.fallidos) {
        texto.textContent += r.fallidos === 1 ? ' · 1 fallida' : ` · ${r.fallidos} fallidas`;
      }

      // Decir POR QUÉ, aunque todavía esté reintentando: no es lo mismo
      // quedarse sin cobertura que subir algo que el servidor rechaza.
      const quedan = r.hechos < r.total;
      const razon = r.sinConexion
        ? (r.persistente
            ? 'Esperando cobertura. Se reanuda sola en cuanto vuelva; puedes cerrar la página.'
            : 'Esperando cobertura. Se reanuda sola en cuanto vuelva: no cierres esta página.')
        : r.ultimoError
          ?? (!r.persistente && quedan ? 'No cierres esta página hasta que termine.' : undefined);
      if (razon) {
        motivo.hidden = false;
        motivo.textContent = /fetch|network|Failed|NetworkError|tiempo de espera|parada|inestable|Sin conexión/i.test(razon)
          ? 'La conexión va a trompicones. Seguimos intentándolo solos; no hace falta que hagas nada.'
          : razon;
      } else {
        motivo.hidden = true;
      }

      if (r.fallidos && !r.subiendo && !r.pendientes) {
        accion.hidden = false;
        accion.textContent = 'Reintentar';
      } else {
        accion.hidden = true;
      }
      // Mientras quede algo sin llegar al servidor, se puede parar.
      ($('progresoParar') as HTMLElement).hidden = r.hechos === r.total;
    });

    $('progresoAccion').addEventListener('click', () => cola.reintentarFallidos());

    $('progresoParar').addEventListener('click', async () => {
      const n = await cola.cancelarTodo();
      subiendo = false;
      sincronizarFab();
      progreso.hidden = true;
      avisar(n === 1 ? 'Subida cancelada' : `${n} subidas canceladas`);
    });
  }
</script>

</body>
</html>
